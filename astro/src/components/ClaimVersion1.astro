---
import { claim } from '../data/content';
---

<section class="claim-v1">
  <div class="container claim-v1__inner">
    <div class="claim-v1__mark" aria-hidden="true"><span></span></div>
    <div class="claim-v1__copy reveal" data-reveal="fade">
      <h2>{claim.title}</h2>
      <p>{claim.text}</p>
    </div>
  </div>
</section>

<style>
  .claim-v1 {
    padding: 26px 0 72px;
    background: var(--cream);
  }

  .claim-v1__inner {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    align-items: center;
    gap: 42px;
    padding: 34px 42px;
    border-radius: 30px;
    background: var(--ink);
    box-shadow: 0 22px 50px rgba(6, 26, 28, 0.12);
  }

  .claim-v1__mark {
    position: relative;
    width: 118px;
    height: 118px;
    border: 1px solid rgba(186, 211, 5, 0.48);
    border-radius: 50%;
  }

  .claim-v1__mark::before,
  .claim-v1__mark::after,
  .claim-v1__mark span {
    content: '';
    position: absolute;
    border-radius: 50%;
  }

  .claim-v1__mark::before {
    inset: 19px;
    border: 1px solid rgba(248, 246, 230, 0.26);
  }

  .claim-v1__mark::after {
    inset: 42px;
    background: var(--lime);
  }

  .claim-v1__mark span {
    width: 16px;
    height: 16px;
    top: 5px;
    left: 50%;
    translate: -50% 0;
    background: var(--cream);
  }

  .claim-v1__copy {
    display: grid;
    grid-template-columns: minmax(300px, 0.92fr) minmax(320px, 1.08fr);
    align-items: center;
    gap: 48px;
  }

  .claim-v1 h2 {
    color: var(--lime);
    font-size: clamp(2.2rem, 3.6vw, 3.6rem);
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .claim-v1 p {
    margin: 0;
    color: rgba(248, 246, 230, 0.78);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .claim-v1__inner {
      grid-template-columns: 90px 1fr;
      gap: 26px;
      padding: 30px;
    }

    .claim-v1__mark {
      width: 82px;
      height: 82px;
    }

    .claim-v1__mark::before { inset: 14px; }
    .claim-v1__mark::after { inset: 30px; }
    .claim-v1__mark span { width: 12px; height: 12px; }
    .claim-v1__copy { grid-template-columns: 1fr; gap: 18px; }
  }

  @media (max-width: 620px) {
    .claim-v1 {
      padding: 14px 12px 50px;
    }

    .claim-v1__inner {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 28px 24px;
      border-radius: 24px;
    }

    .claim-v1__mark {
      width: 66px;
      height: 66px;
    }

    .claim-v1__mark::after { inset: 24px; }
    .claim-v1 h2 { font-size: 2.35rem; }
    .claim-v1 p { font-size: 0.98rem; }
  }
</style>
