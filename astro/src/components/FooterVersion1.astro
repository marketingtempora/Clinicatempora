---
import { site } from '../data/content';
---

<footer class="footer-v1">
  <div class="container footer-v1__inner">
    <div class="footer-v1__brand">
      <img
        src="/assets/img/logo-tempora-blanco-321.webp"
        srcset="/assets/img/logo-tempora-blanco-321.webp 1x, /assets/img/logo-tempora-blanco-642.webp 2x"
        width="321"
        height="55"
        alt="Clínica Témpora"
        loading="lazy"
      />
    </div>

    <div class="footer-v1__information">
      <div>
        <span>DIRECCIÓN</span>
        <p>{site.address.street}, {site.address.locality}</p>
      </div>
      <div>
        <span>HORARIO DE ATENCIÓN</span>
        <p>{site.hours}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-v1 {
    position: relative;
    min-height: 520px;
    background:
      radial-gradient(circle at 50% -30%, rgba(186, 211, 5, 0.19), transparent 42%),
      var(--ink);
    color: var(--cream);
    overflow: hidden;
  }

  .footer-v1::before,
  .footer-v1::after {
    position: absolute;
    left: 50%;
    border: 1px solid rgba(186, 211, 5, 0.2);
    border-radius: 50%;
    content: '';
    pointer-events: none;
    transform: translateX(-50%);
  }

  .footer-v1::before {
    top: -390px;
    width: 760px;
    height: 760px;
  }

  .footer-v1::after {
    top: -315px;
    width: 610px;
    height: 610px;
    border-color: rgba(248, 246, 230, 0.08);
  }

  .footer-v1__inner {
    position: relative;
    z-index: 1;
  }

  .footer-v1__brand {
    display: grid;
    min-height: 380px;
    place-items: center;
  }

  .footer-v1__brand img {
    width: min(47vw, 520px);
    border-radius: 0;
  }

  .footer-v1__information {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 60px;
    padding: 34px 0 44px;
    border-top: 1px solid rgba(248, 246, 230, 0.14);
  }

  .footer-v1__information > div:last-child {
    text-align: right;
  }

  .footer-v1__information span {
    color: var(--lime);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .footer-v1__information p {
    margin: 9px 0 0;
    color: rgba(248, 246, 230, 0.74);
    font-size: 0.94rem;
    line-height: 1.5;
  }

  @media (max-width: 767px) {
    .footer-v1 {
      min-height: 600px;
    }

    .footer-v1::before {
      top: -235px;
      width: 470px;
      height: 470px;
    }

    .footer-v1::after {
      top: -185px;
      width: 370px;
      height: 370px;
    }

    .footer-v1__brand {
      min-height: 355px;
    }

    .footer-v1__brand img {
      width: min(78vw, 300px);
    }

    .footer-v1__information {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 30px 0 120px;
    }

    .footer-v1__information > div:last-child {
      text-align: left;
    }
  }
</style>
