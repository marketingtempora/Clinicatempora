---
import { site } from '../data/content';
---

<footer class="footer-v1">
  <div class="container footer-v1__inner">
    <img src="/assets/img/logo-tempora-blanco.webp" width="321" height="54" alt="Clínica Témpora" loading="lazy" />
    <div><strong>{site.address.street}</strong><span>{site.address.locality}</span></div>
    <div><strong>Lunes a viernes</strong><span>{site.hours.replace('Lunes a viernes ', '')}</span></div>
  </div>
</footer>

<style>
  .footer-v1 {
    padding: 34px 0 92px;
    background: var(--ink);
    color: var(--cream);
  }

  .footer-v1__inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 60px;
    padding-top: 34px;
    border-top: 1px solid rgba(248, 246, 230, 0.12);
  }

  .footer-v1__inner > img {
    width: 190px;
    border-radius: 0;
  }

  .footer-v1__inner > div {
    display: grid;
  }

  .footer-v1 strong {
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .footer-v1 span {
    color: rgba(248, 246, 230, 0.74);
    font-size: 0.74rem;
    font-weight: 500;
    line-height: 1.4;
  }

  @media (max-width: 767px) {
    .footer-v1 {
      padding-bottom: 104px;
    }

    .footer-v1__inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
