---
import Layout from '../layouts/Layout.astro';

interface Props {
  landing: 'lp1' | 'lp2';
}

const { landing } = Astro.props;
const isLp1 = landing === 'lp1';
const eventName = `tempora_${landing}_autoagenda_completed`;
const title = isLp1 ? '¡Tu evaluación quedó agendada!' : '¡Tu hora fue reservada con éxito!';
const message = isLp1
  ? 'Gracias por reservar tu evaluación capilar. Si necesitamos confirmar algún detalle antes de tu cita, nos pondremos en contacto contigo.'
  : 'Tu evaluación capilar ya está agendada. El equipo de Clínica Témpora te contactará si necesita confirmar algún detalle antes de tu cita.';
---

<Layout
  title="Reserva confirmada | Clínica Témpora"
  description="Confirmación de reserva de evaluación capilar en Clínica Témpora."
  robots="noindex, nofollow"
>
  <main
    class="reservation-thanks"
    id="hero"
    data-reservation-event={eventName}
    data-landing-version={landing}
  >
    <div class="reservation-thanks__orb reservation-thanks__orb--top" aria-hidden="true"></div>
    <div class="reservation-thanks__orb reservation-thanks__orb--bottom" aria-hidden="true"></div>

    <section class="reservation-thanks__card" aria-labelledby="reservation-thanks-title">
      <img
        class="reservation-thanks__logo"
        src="/assets/img/logo-tempora-blanco.webp"
        width="321"
        height="54"
        alt="Clínica Témpora"
      />

      <div class="reservation-thanks__icon" aria-hidden="true">
        <svg viewBox="0 0 64 64" role="presentation">
          <rect x="10" y="15" width="44" height="39" rx="8"></rect>
          <path d="M20 9v12M44 9v12M10 27h44M22 40l7 7 14-15"></path>
        </svg>
      </div>

      <p class="reservation-thanks__eyebrow">Reserva confirmada</p>
      <h1 id="reservation-thanks-title">{title}</h1>
      <p class="reservation-thanks__message">{message}</p>
    </section>
  </main>
</Layout>

<style>
  :global(body) {
    background: var(--ink);
  }

  .reservation-thanks {
    position: relative;
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: 32px 20px;
    background:
      linear-gradient(135deg, rgba(45, 80, 87, 0.58), rgba(6, 26, 28, 0.94)),
      url('/assets/img/v2/tempora-galeria3.webp') 55% center / cover no-repeat;
    isolation: isolate;
    overflow: hidden;
  }

  .reservation-thanks::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(180deg, rgba(6, 26, 28, 0.16), rgba(6, 26, 28, 0.68));
    content: '';
  }

  .reservation-thanks__orb {
    position: absolute;
    z-index: -1;
    width: 420px;
    height: 420px;
    border: 1px solid rgba(186, 211, 5, 0.22);
    border-radius: 50%;
    box-shadow: inset 0 0 100px rgba(186, 211, 5, 0.08);
  }

  .reservation-thanks__orb--top {
    top: -250px;
    right: -120px;
  }

  .reservation-thanks__orb--bottom {
    bottom: -300px;
    left: -150px;
  }

  .reservation-thanks__card {
    width: min(100%, 690px);
    padding: clamp(32px, 6vw, 68px);
    border: 1px solid rgba(248, 246, 230, 0.16);
    border-top: 4px solid var(--lime);
    border-radius: 32px;
    background: rgba(6, 26, 28, 0.92);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.38);
    color: var(--cream);
    text-align: center;
    backdrop-filter: blur(18px);
  }

  .reservation-thanks__logo {
    width: min(220px, 70%);
    margin: 0 auto clamp(30px, 5vw, 50px);
    border-radius: 0;
  }

  .reservation-thanks__icon {
    display: grid;
    width: 84px;
    height: 84px;
    margin: 0 auto 24px;
    place-items: center;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 14px 38px rgba(186, 211, 5, 0.22);
  }

  .reservation-thanks__icon svg {
    width: 52px;
    height: 52px;
    fill: none;
    stroke: var(--ink);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 3.5;
  }

  .reservation-thanks__eyebrow {
    margin: 0 0 12px;
    color: var(--lime);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .reservation-thanks h1 {
    max-width: 590px;
    margin: 0 auto;
    color: var(--cream);
    font-size: clamp(2.3rem, 6vw, 4.25rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .reservation-thanks__message {
    max-width: 540px;
    margin: 22px auto 0;
    color: rgba(248, 246, 230, 0.78);
    font-size: clamp(1rem, 2.3vw, 1.2rem);
    line-height: 1.55;
  }

  @media (max-width: 540px) {
    .reservation-thanks {
      padding: 18px;
      background-position: 62% center;
    }

    .reservation-thanks__card {
      padding: 34px 24px 42px;
      border-radius: 24px;
    }

    .reservation-thanks__logo {
      margin-bottom: 32px;
    }

    .reservation-thanks__icon {
      width: 72px;
      height: 72px;
    }

    .reservation-thanks__icon svg {
      width: 44px;
      height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reservation-thanks__card {
      backdrop-filter: none;
    }
  }
</style>

<script>
  const confirmation = document.querySelector<HTMLElement>('[data-reservation-event]');
  if (confirmation?.dataset.reservationEvent) {
    window.dataLayer ??= [];
    window.dataLayer.push({
      event: confirmation.dataset.reservationEvent,
      conversion_type: 'autoagenda',
      form_version: confirmation.dataset.landingVersion ?? '',
      page_type: 'reservation_thanks',
    });
  }
</script>
