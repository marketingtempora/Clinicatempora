---
import { testimonials } from '../data/content';
import Carousel from './Carousel.astro';
import YouTubeFacade from './YouTubeFacade.astro';
---

<section class="voices-v1" id="testimonios">
  <div class="container">
    <div class="voices-v1__head reveal" data-reveal="fade">
      <div>
        <p>HISTORIAS REALES</p>
        <h2>{testimonials.title}</h2>
      </div>
      <div class="voices-v1__intro">
        <p>{testimonials.text}</p>
        <a href="#form">QUIERO AGENDAR <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="voices-v1__carousel">
      <Carousel
        perView={3}
        perViewTablet={2}
        perViewMobile={1}
        label="Testimonios de pacientes"
        prevLabel="Testimonio anterior"
        nextLabel="Testimonio siguiente"
      >
        {testimonials.videos.map((video) => (
          <li class="carousel__slide voices-v1__card reveal" data-reveal="fade-up">
            <div class="voices-v1__meta">
              <span>TESTIMONIO</span>
              <span>{video.name}</span>
            </div>
            <YouTubeFacade id={video.id} thumb={video.thumb} alt={video.alt} ratio="vertical" />
          </li>
        ))}
      </Carousel>
    </div>
  </div>
</section>

<style>
  .voices-v1 {
    padding: 60px 0 68px;
    background: var(--cream);
    overflow: hidden;
  }

  .voices-v1__head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(330px, 0.55fr);
    align-items: end;
    gap: 42px;
    margin-bottom: 28px;
  }

  .voices-v1__head > div:first-child > p {
    margin: 0 0 16px;
    color: var(--teal);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .voices-v1 h2 {
    max-width: 720px;
    color: var(--teal);
    font-size: clamp(2.8rem, 4.4vw, 4.6rem);
    letter-spacing: -0.055em;
    line-height: 0.96;
  }

  .voices-v1__intro > p {
    margin: 0 0 24px;
    color: var(--muted);
    line-height: 1.7;
  }

  .voices-v1__intro > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    border-top: 1px solid rgba(45, 80, 87, 0.16);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 800;
  }

  .voices-v1__intro > a span { font-size: 1.3rem; }

  .voices-v1__carousel { min-width: 0; }
  .voices-v1__carousel :global(.carousel) { --dots-space: 20px; }
  .voices-v1__carousel :global(.carousel__viewport) { padding-bottom: 28px; }
  .voices-v1__carousel :global(.carousel__track) { align-items: flex-start; }

  .voices-v1__card {
    min-width: 0;
    padding: 14px;
    border: 1px solid rgba(45, 80, 87, 0.12);
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.52);
  }

  .voices-v1__card:nth-child(even) { transform: translateY(28px); }

  .voices-v1__meta {
    display: flex;
    justify-content: space-between;
    padding: 3px 2px 12px;
    color: var(--teal);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .voices-v1__card :global(.video) {
    aspect-ratio: 4 / 5;
    border-radius: 17px;
  }

  @media (max-width: 767px) {
    .voices-v1 { padding: 42px 0 44px; }
    .voices-v1__head { grid-template-columns: 1fr; gap: 22px; margin-bottom: 30px; }
    .voices-v1 h2 { font-size: 2.7rem; }
    .voices-v1__carousel {
      margin-inline: -20px;
      padding-inline: 20px;
    }
    .voices-v1__carousel :global(.carousel__viewport) { padding-bottom: 0; }
    .voices-v1__card { border-radius: 22px; }
    .voices-v1__card:nth-child(even) { transform: none; }
    .voices-v1__card :global(.video) { aspect-ratio: 4 / 5; }
  }
</style>
