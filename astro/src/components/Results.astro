---
import { results } from '../data/content';
---

<section class="results" id="resultados">
  <div class="container results__inner">
    <div class="results__head reveal" data-reveal="fade">
      <h2 class="results__title">{results.titleLine1}</h2>
      <h2 class="results__title">{results.titleLine2}</h2>
      <p class="results__text">{results.text}</p>
    </div>

    <ol class="timeline reveal" data-reveal="fade">
      {results.steps.map((step, i) => (
        <li class="timeline__item">
          <img class="timeline__img" src={step.img} alt={step.alt} loading="lazy" width="219" height="147" />
          <div
            class:list={[
              'timeline__line',
              { 'timeline__line--first': i === 0, 'timeline__line--last': i === results.steps.length - 1 },
            ]}
            aria-hidden="true"
          >
            <span class="timeline__dot"></span>
          </div>
          <h3 class="timeline__label">{step.label}</h3>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .results {
    padding-block: var(--section-y);
    overflow: hidden;
  }
  .results__inner {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin-bottom: var(--stack-gap);
  }
  .results__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    /* el widget de texto del original tiene margen inferior negativo */
    margin-bottom: var(--stack-pull);
    text-align: center;
  }
  .results__title {
    margin-top: var(--stack-gap);
    color: var(--teal);
  }
  .results__text {
    /* margen inferior = 1.2em del propio tamaño, como el <p> del original */
    margin: 0 0 1.2em;
    color: var(--teal);
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: 400;
    line-height: 1.2;
  }

  .timeline {
    display: flex;
    padding: 10px;
  }
  .timeline__item {
    flex: 0 0 25%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }
  /* El original sirve estas imágenes a su tamaño natural (219x147) y centradas */
  .timeline__img {
    width: 219px;
    max-width: calc(100% - 20px);
    margin: 10px auto;
    border-radius: var(--radius-xs);
  }
  .timeline__line {
    position: relative;
    display: flex;
    align-items: center;
    height: 29px;
    padding-block: 10px;
  }
  .timeline__line::before {
    content: '';
    width: 100%;
    height: 3px;
    background-color: var(--lime);
  }
  .timeline__line--first::before {
    background-image: linear-gradient(to right, var(--cream) 50%, var(--lime) 50%);
  }
  .timeline__line--last::before {
    background-image: linear-gradient(to right, var(--lime) 50%, var(--cream) 50%);
  }
  .timeline__dot {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    width: 27px;
    height: 27px;
    border-radius: 50%;
    background-color: var(--lime);
  }
  .timeline__label {
    color: var(--muted);
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
  }

  @media (max-width: 1024px) {
  }

  @media (max-width: 767px) {
    .timeline {
      flex-direction: column;
    }
    .timeline__line {
      display: none;
    }
    /* en columna, flex-basis afecta al alto: hay que soltarlo */
    .timeline__item {
      flex: 0 0 auto;
    }
  }
</style>
