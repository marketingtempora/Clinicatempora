---
import { results } from '../data/content';
---

<section class="results-v1" id="resultados">
  <div class="container">
    <div class="results-v1__head reveal" data-reveal="fade">
      <p class="results-v1__eyebrow">EVOLUCIÓN</p>
      <h2><span>{results.titleLine1}</span> {results.titleLine2}</h2>
      <p>{results.text}</p>
    </div>

    <ol class="results-v1__track reveal" data-reveal="fade" aria-label="Evolución del implante capilar">
      {results.steps.map((step, index) => (
        <li class:list={['results-v1__card', { 'is-final': index === results.steps.length - 1 }]}>
          <div class="results-v1__card-top">
            <span class="results-v1__index">{String(index + 1).padStart(2, '0')}</span>
            <span class="results-v1__line" aria-hidden="true"></span>
          </div>
          <img src={step.img} alt={step.alt} loading="lazy" width="219" height="147" />
          <div class="results-v1__card-foot">
            <span class="results-v1__dot" aria-hidden="true"></span>
            <h3>{step.label}</h3>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .results-v1 {
    position: relative;
    padding: 90px 0 100px;
    background:
      radial-gradient(circle at 8% 12%, rgba(186, 211, 5, 0.16), transparent 22%),
      var(--cream);
    overflow: hidden;
  }

  .results-v1__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.72fr);
    align-items: end;
    gap: 26px 60px;
    margin-bottom: 48px;
  }

  .results-v1__eyebrow {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--teal);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .results-v1__head h2 {
    color: var(--teal);
    font-size: clamp(3rem, 5vw, 5rem);
    letter-spacing: -0.05em;
    line-height: 0.96;
  }

  .results-v1__head h2 span {
    display: block;
    color: var(--ink);
    font-size: 0.53em;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .results-v1__head > p:last-child {
    margin: 0 0 6px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .results-v1__track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .results-v1__card {
    min-width: 0;
    padding: 18px;
    border: 1px solid rgba(45, 80, 87, 0.12);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.58);
    transition: transform 250ms ease, box-shadow 250ms ease, background-color 250ms ease;
  }

  .results-v1__card:hover {
    transform: translateY(-8px);
    box-shadow: 0 22px 40px rgba(6, 26, 28, 0.11);
  }

  .results-v1__card.is-final {
    border-color: var(--teal);
    background: var(--teal);
    box-shadow: 0 22px 45px rgba(6, 26, 28, 0.16);
  }

  .results-v1__card-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .results-v1__index {
    color: var(--teal);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .results-v1__line {
    flex: 1;
    height: 1px;
    background: rgba(45, 80, 87, 0.16);
  }

  .results-v1__card.is-final .results-v1__index { color: var(--lime); }
  .results-v1__card.is-final .results-v1__line { background: rgba(248, 246, 230, 0.2); }

  .results-v1__card img {
    width: 100%;
    aspect-ratio: 219 / 147;
    border-radius: 16px;
    object-fit: cover;
  }

  .results-v1__card-foot {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 2px 2px;
  }

  .results-v1__dot {
    width: 12px;
    height: 12px;
    border: 3px solid var(--lime);
    border-radius: 50%;
  }

  .results-v1__card h3 {
    color: var(--teal);
    font-size: 1.65rem;
    letter-spacing: -0.035em;
  }

  .results-v1__card.is-final h3 { color: var(--cream); }

  @media (max-width: 900px) {
    .results-v1__head {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .results-v1__track {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .results-v1 {
      padding: 64px 0 72px;
    }

    .results-v1__head {
      margin-bottom: 30px;
    }

    .results-v1__head h2 {
      font-size: 3.15rem;
    }

    .results-v1__head > p:last-child {
      font-size: 0.98rem;
    }

    .results-v1__track {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      gap: 12px;
      margin-inline: -20px;
      padding: 4px 20px 24px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline mandatory;
      scrollbar-width: none;
    }

    .results-v1__track::-webkit-scrollbar { display: none; }

    .results-v1__card {
      padding: 14px;
      border-radius: 20px;
      scroll-snap-align: center;
    }

    .results-v1__card h3 {
      font-size: 1.5rem;
    }
  }
</style>
