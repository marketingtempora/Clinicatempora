---
import { results } from '../data/content';
---

<section class="results-v1" id="resultados">
  <div class="container">
    <div class="results-v1__head reveal" data-reveal="fade">
      <p class="results-v1__eyebrow">EVOLUCIÓN</p>
      <h2><span>{results.titleLine1}</span> {results.titleLine2}</h2>
      <p>{results.text}</p>
    </div>

    <ol class="results-v1__track reveal" data-reveal="fade" aria-label="Evolución del implante capilar">
      {results.steps.map((step, index) => (
        <li class:list={['results-v1__card', { 'is-final': index === results.steps.length - 1 }]}>
          <div class="results-v1__moment">
            <span class="results-v1__dot" aria-hidden="true"></span>
            <span>Etapa {index + 1}</span>
          </div>
          <div class="results-v1__image">
            <img src={step.img} alt={step.alt} loading="lazy" width="219" height="147" />
          </div>
          <div class="results-v1__card-copy">
            <h3>{step.label}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .results-v1 {
    position: relative;
    padding: 54px 0 60px;
    background:
      radial-gradient(circle at 8% 12%, rgba(186, 211, 5, 0.16), transparent 22%),
      var(--cream);
    overflow: hidden;
  }

  .results-v1__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.72fr);
    align-items: end;
    gap: 26px 60px;
    margin-bottom: 30px;
  }

  .results-v1__eyebrow {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--teal);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .results-v1__head h2 {
    color: var(--teal);
    font-size: clamp(2.8rem, 4.4vw, 4.6rem);
    letter-spacing: -0.05em;
    line-height: 0.96;
  }

  .results-v1__head h2 span {
    display: block;
    color: var(--ink);
    font-size: 0.53em;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .results-v1__head > p:last-child {
    margin: 0 0 6px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .results-v1__track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    padding: 26px 0 18px;
  }

  .results-v1__track::before {
    content: '';
    position: absolute;
    top: 50%;
    right: 4%;
    left: 4%;
    height: 2px;
    background: linear-gradient(90deg, rgba(45, 80, 87, 0.2), var(--lime) 82%, var(--teal));
  }

  .results-v1__track::after {
    content: '';
    position: absolute;
    right: calc(4% - 2px);
    top: 50%;
    width: 11px;
    height: 11px;
    border-top: 2px solid var(--teal);
    border-right: 2px solid var(--teal);
    transform: translateY(-50%) rotate(45deg);
  }

  .results-v1__card {
    position: relative;
    z-index: 1;
    min-width: 0;
    padding: 14px;
    border: 1px solid rgba(45, 80, 87, 0.12);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 14px 36px rgba(6, 26, 28, 0.08);
    transition: transform 250ms ease, box-shadow 250ms ease, background-color 250ms ease;
  }

  .results-v1__card:nth-of-type(odd) { transform: translateY(-24px); }
  .results-v1__card:nth-of-type(even) { transform: translateY(24px); }

  .results-v1__card:nth-of-type(odd):hover { transform: translateY(-32px); }
  .results-v1__card:nth-of-type(even):hover { transform: translateY(16px); }

  .results-v1__card:hover {
    box-shadow: 0 22px 40px rgba(6, 26, 28, 0.11);
  }

  .results-v1__card.is-final {
    border-color: var(--teal);
    background: var(--teal);
    box-shadow: 0 22px 45px rgba(6, 26, 28, 0.16);
  }

  .results-v1__moment {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 3px 2px 12px;
    color: var(--teal);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .results-v1__card.is-final .results-v1__moment { color: var(--lime); }

  .results-v1__image {
    padding: 8px;
    border-radius: 17px;
    background: #e9ecdf;
  }

  .results-v1__image img {
    width: 100%;
    aspect-ratio: 219 / 147;
    border-radius: 12px;
    object-fit: cover;
  }

  .results-v1__card-copy {
    padding: 16px 4px 4px;
  }

  .results-v1__dot {
    flex: 0 0 10px;
    width: 10px;
    height: 10px;
    border: 2px solid var(--cream);
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 2px var(--teal);
  }

  .results-v1__card h3 {
    color: var(--teal);
    font-size: 1.75rem;
    letter-spacing: -0.035em;
  }

  .results-v1__card p {
    margin: 7px 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.48;
  }

  .results-v1__card.is-final h3 { color: var(--cream); }
  .results-v1__card.is-final p { color: rgba(248, 246, 230, 0.72); }
  .results-v1__card.is-final .results-v1__image { background: rgba(248, 246, 230, 0.1); }

  @media (max-width: 900px) {
    .results-v1__head {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .results-v1__track {
      grid-template-columns: repeat(2, 1fr);
      gap: 58px 18px;
    }

    .results-v1__track::before,
    .results-v1__track::after { display: none; }
  }

  @media (max-width: 620px) {
    .results-v1 {
      padding: 44px 0 48px;
    }

    .results-v1__head {
      margin-bottom: 30px;
    }

    .results-v1__head h2 {
      font-size: 2.75rem;
    }

    .results-v1__head > p:last-child {
      font-size: 0.98rem;
    }

    .results-v1__track {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      gap: 12px;
      margin-inline: -20px;
      padding: 4px 20px 24px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline mandatory;
      scrollbar-width: none;
    }

    .results-v1__track::-webkit-scrollbar { display: none; }

    .results-v1__card {
      padding: 14px;
      border-radius: 20px;
      scroll-snap-align: center;
      transform: none !important;
    }

    .results-v1__card h3 {
      font-size: 1.5rem;
    }
  }
</style>
