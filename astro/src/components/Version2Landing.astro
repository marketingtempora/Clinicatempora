---
import LeadForm from './LeadForm.astro';
import YouTubeFacade from './YouTubeFacade.astro';

const results = [
  { before: '001A-1.jpg', after: '001B-1.jpg', label: 'Caso 01 · 3.000 folículos' },
  { before: '002A.jpg', after: '002B.jpg', label: 'Caso 02 · 2.900 folículos' },
  { before: '006A.jpg', after: '006B.jpg', label: 'Caso 03 · 2.000 folículos' },
] as const;

const faqs = [
  {
    question: '¿Cómo sé si soy candidato a un implante capilar?',
    answer:
      'La evaluación revisa tu tipo de alopecia, la calidad de la zona donante, tus antecedentes y el resultado que buscas. Con esa información el equipo puede indicarte si el implante es adecuado para ti.',
  },
  {
    question: '¿Cómo sé si necesito FUE o FUSS?',
    answer:
      'No tienes que decidirlo antes. El equipo evalúa tu tipo de alopecia, zona donante, cantidad de folículos y objetivos para recomendar FUE, FUSS o una combinación de ambas.',
  },
  {
    question: '¿Es necesario internarse?',
    answer:
      'No. Es una cirugía ambulatoria con anestesia local. Recibes indicaciones de cuidado y continúas con el programa de seguimiento de la clínica.',
  },
  {
    question: '¿El cabello implantado es permanente?',
    answer:
      'Los folículos se obtienen de una zona genéticamente más resistente a la alopecia. Su permanencia y la evolución del cabello nativo se revisan en la evaluación y en los controles posteriores.',
  },
  {
    question: '¿Cómo es la recuperación?',
    answer:
      'Recibirás indicaciones específicas para los primeros días y controles médicos durante la evolución. Los tiempos dependen de la técnica y de las características de cada paciente.',
  },
  {
    question: '¿El procedimiento duele?',
    answer:
      'La cirugía se realiza con anestesia local. Durante la evaluación el equipo explica cada etapa, las sensaciones esperables y los cuidados para una recuperación confortable.',
  },
] as const;
---

<div class="version2">
  <header class="v2-nav" data-v2-nav>
    <div class="v2-container v2-nav__inner">
      <a class="v2-nav__brand" href="#inicio" aria-label="Clínica Témpora, inicio">
        <img src="/assets/img/logo-tempora-blanco.webp" width="321" height="54" alt="Clínica Témpora" />
      </a>
      <nav class="v2-nav__links" aria-label="Navegación principal">
        <a href="#resultados">Resultados</a>
        <a href="#proceso">Proceso</a>
        <a href="#tecnicas">Técnicas</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <a class="v2-button v2-button--lime v2-nav__cta" href="#form">Quiero agendar</a>
    </div>
  </header>

  <main id="hero">
    <section class="v2-hero" id="inicio">
      <div class="v2-hero__glow" aria-hidden="true"></div>
      <div class="v2-container v2-hero__grid">
        <div class="v2-hero__copy">
          <p class="v2-kicker">+ de 2.500 pacientes tratados</p>
          <h1>Implante capilar <span>Vuelve a tener pelo.</span></h1>
          <ul class="v2-hero__checks" aria-label="Características principales">
            <li><span aria-hidden="true">✓</span> Diagnóstico preciso y plan personalizado</li>
            <li><span aria-hidden="true">✓</span> Implante capilar ambulatorio y seguimiento médico</li>
            <li><span aria-hidden="true">✓</span> La primera clínica especializada en Chile</li>
          </ul>
          <figure class="v2-hero__mobile-visual">
            <img
              src="/assets/img/v2/tempora-galeria6.webp"
              width="960"
              height="829"
              alt="Paciente durante una evaluación capilar con una especialista de Clínica Témpora"
              loading="eager"
            />
            <figcaption>Evaluación capilar personalizada con especialistas</figcaption>
          </figure>
          <div class="v2-hero__actions">
            <a class="v2-button v2-button--lime" href="#form">Quiero agendar</a>
            <a class="v2-text-link" href="#resultados">Ver resultados <span aria-hidden="true">↘</span></a>
          </div>
        </div>

        <div class="v2-form-shell" id="form" data-form-shell>
          <div class="v2-form-shell__topline">
            <span>Evaluación capilar</span>
          </div>
          <LeadForm
            fieldsPerStep={4}
            compactPhonePrompt
            stepEventNames={['form_step1']}
            finalEventName="formstep2_final"
            formVersion="v2"
          />
        </div>
      </div>
    </section>

    <section class="v2-results v2-section" id="resultados">
      <div class="v2-container">
        <div class="v2-heading v2-heading--center v2-heading--light">
          <p class="v2-kicker">Documentados en controles clínicos</p>
          <h2>Resultados reales de<br /><span>implante capilar.</span></h2>
          <p>Casos publicados por la clínica. El resultado y la evolución pueden variar entre pacientes.</p>
        </div>

        <div class="v2-results__grid">
          {results.map((result, index) => (
            <article class:list={['v2-case', { 'v2-case--wide': index === 0 }]}>
              <div class="v2-case__compare" style="--split: 50%" data-comparison>
                <img class="v2-case__after" src={`/assets/img/v2/${result.after}`} width="1080" height="872" alt={`${result.label}, después del implante capilar`} loading="lazy" />
                <div class="v2-case__before" data-before>
                  <img src={`/assets/img/v2/${result.before}`} width="1080" height="872" alt={`${result.label}, antes del implante capilar`} loading="lazy" />
                </div>
                <span class="v2-case__tag v2-case__tag--before">Antes</span>
                <span class="v2-case__tag v2-case__tag--after">Después</span>
                <span class="v2-case__divider" aria-hidden="true"><i>↔</i></span>
                <input type="range" min="8" max="92" value="50" aria-label={`Comparar antes y después de ${result.label}`} data-comparison-range />
              </div>
              <h3>{result.label}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="v2-method v2-section" id="proceso">
      <div class="v2-container v2-method__grid">
        <div class="v2-method__copy">
          <p class="v2-kicker v2-kicker--dark">Un plan diseñado para tu caso</p>
          <h2>Naturalidad, densidad y una línea capilar hecha para ti.</h2>
          <p class="v2-method__lead">
            Cada implante capilar se planifica según tu rostro, tu alopecia y tu zona donante para definir la técnica y el resultado posible en tu caso.
          </p>
        </div>

        <figure class="v2-method__visual">
          <img src="/assets/img/v2/hero-foto.webp" width="984" height="711" alt="Procedimiento de implante capilar en Clínica Témpora" loading="lazy" />
          <figcaption>Procedimiento ambulatorio realizado por el equipo de Clínica Témpora.</figcaption>
        </figure>
      </div>

      <ol class="v2-container v2-steps" aria-label="Etapas del proceso de implante capilar">
        <li><span>01</span><div><strong>Evaluación</strong><p>Revisamos alopecia, zona donante, objetivos y antecedentes.</p></div></li>
        <li><span>02</span><div><strong>Diseño</strong><p>Definimos la línea capilar y la cantidad estimada de folículos.</p></div></li>
        <li><span>03</span><div><strong>Cirugía</strong><p>Realizamos el implante capilar con la técnica indicada para tu caso.</p></div></li>
        <li><span>04</span><div><strong>Seguimiento</strong><p>Acompañamos la evolución con controles postoperatorios.</p></div></li>
      </ol>

      <aside class="v2-container v2-tech-note" id="tecnicas" aria-label="Técnicas de implante capilar">
        <span>Indicación médica personalizada</span>
        <p><strong>Trabajamos con FUE y FUSS.</strong> El equipo define la técnica según tu zona donante, grado de alopecia y cantidad de folículos necesarios.</p>
      </aside>
    </section>

    <section class="v2-media v2-section" id="historias">
      <div class="v2-container">
        <div class="v2-heading v2-heading--stories v2-heading--light">
          <div>
            <p class="v2-kicker">Casos, no promesas</p>
            <h2>La experiencia contada por quienes la vivieron.</h2>
          </div>
        </div>

        <div class="v2-media__carousel" data-media-carousel>
          <div class="v2-media__track" data-media-track>
            <article class="v2-media__slide is-active" data-media-slide style="--thumb-y: 18%; --thumb-y-mobile: 25%;">
              <div class="v2-media__video"><YouTubeFacade id="gAZ2xNm--Bo" alt="Juliano contando su experiencia en Clínica Témpora" thumb="/assets/img/v2/JULIANO.jpg" /></div>
              <div class="v2-media__copy"><span>Juliano · Rancagua</span><h3>“Los resultados superaron mis expectativas.”</h3><p>Destaca la claridad del equipo médico y el acompañamiento durante todo el proceso.</p></div>
            </article>
            <article class="v2-media__slide" data-media-slide style="--thumb-y: 19%; --thumb-y-mobile: 25%;">
              <div class="v2-media__video"><YouTubeFacade id="h08RqUihV1I" alt="Pablo contando su experiencia en Clínica Témpora" thumb="/assets/img/v2/PABLO.jpg" /></div>
              <div class="v2-media__copy"><span>Pablo · Santiago</span><h3>Una decisión para recuperar su imagen.</h3><p>Su experiencia muestra cómo se vive el procedimiento desde la mirada del paciente.</p></div>
            </article>
            <article class="v2-media__slide" data-media-slide style="--thumb-y: 20%; --thumb-y-mobile: 27%;">
              <div class="v2-media__video"><YouTubeFacade id="P7t6AGGPv48" alt="Joaquín contando su experiencia en Clínica Témpora" thumb="/assets/img/v2/JOAQUIN.jpg" /></div>
              <div class="v2-media__copy"><span>Joaquín · Valdivia</span><h3>“Fue la mejor decisión que tomé.”</h3><p>Relata un proceso profesional, acompañado y enfocado en un resultado natural.</p></div>
            </article>
          </div>
          <div class="v2-media__controls">
            <button type="button" aria-label="Video anterior" data-media-prev>←</button>
            <div class="v2-media__dots" aria-label="Seleccionar video">
              <button type="button" class="is-active" aria-label="Ver video 1" aria-current="true" data-media-dot="0"></button>
              <button type="button" aria-label="Ver video 2" data-media-dot="1"></button>
              <button type="button" aria-label="Ver video 3" data-media-dot="2"></button>
            </div>
            <button type="button" aria-label="Video siguiente" data-media-next>→</button>
          </div>
        </div>
      </div>
    </section>

    <section class="v2-clinic v2-section" id="clinica">
      <div class="v2-container">
        <div class="v2-clinic__head">
          <div>
          <p class="v2-kicker v2-kicker--dark">Equipo médico especializado</p>
          <h2>Tu resultado comienza con quién evalúa y opera.</h2>
          </div>
          <p>
            Clínica Témpora reúne profesionales dedicados al implante capilar con técnicas FUE y FUSS, formación internacional y actualización continua.
          </p>
        </div>
        <div class="v2-clinic__doctors" aria-label="Equipo médico de Clínica Témpora">
          <article>
            <img src="/assets/img/v2/JESUS-1_00000000-2.jpg" width="700" height="700" alt="Dra. Jesús Díaz, fundadora y directora médica de Clínica Témpora" loading="lazy" />
            <div><strong>Dra. Jesús Díaz</strong><span>Fundadora y directora médica</span></div>
          </article>
          <article>
            <img src="/assets/img/v2/FRANCISCO-1_00000000.jpg" width="700" height="700" alt="Dr. Francisco Castellón, director de restauración capilar" loading="lazy" />
            <div><strong>Dr. Francisco Castellón</strong><span>Director de restauración capilar</span></div>
          </article>
          <article>
            <img src="/assets/img/v2/SOFIA-1_00000000.jpg" width="700" height="700" alt="Dra. Sofía Viaux, directora de Investigación y Desarrollo" loading="lazy" />
            <div><strong>Dra. Sofía Viaux</strong><span>Directora de Investigación y Desarrollo</span></div>
          </article>
          <article>
            <img src="/assets/img/v2/NICOLAS-1_00000000.jpg" width="700" height="700" alt="Dr. Nicolás Herrera, director de evaluaciones" loading="lazy" />
            <div><strong>Dr. Nicolás Herrera</strong><span>Director de evaluaciones</span></div>
          </article>
        </div>
      </div>
    </section>

    <section class="v2-faq v2-section" id="preguntas">
      <div class="v2-container v2-faq__grid">
        <div class="v2-faq__intro">
          <p class="v2-kicker v2-kicker--dark">Antes de decidir</p>
          <h2>Preguntas que merecen respuestas claras.</h2>
        </div>
        <div class="v2-faq__list">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.question}<span aria-hidden="true">+</span></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="v2-final">
      <div class="v2-container v2-final__panel">
        <img src="/assets/img/v2/SEBASTIAN.jpg" width="750" height="750" alt="Sebastián, paciente de Clínica Témpora" loading="lazy" />
        <div class="v2-final__copy">
          <p class="v2-kicker">Tu caso empieza con una evaluación</p>
          <h2>Descubre qué resultado es posible para ti.</h2>
          <a class="v2-button v2-button--lime" href="#form">Agenda tu evaluación de implante capilar</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="v2-footer">
    <div class="v2-container v2-footer__inner">
      <img src="/assets/img/logo-tempora-blanco.webp" width="321" height="54" alt="Clínica Témpora" />
      <div><strong>Suecia 0142, oficina 603</strong><span>Providencia, Santiago</span></div>
      <div><strong>Lunes a viernes</strong><span>9:00 a 18:00 hrs.</span></div>
    </div>
  </footer>

  <a class="v2-floating" href="#form" data-floating>Quiero agendar <span aria-hidden="true">→</span></a>
</div>

<style is:global>
  @font-face { font-family: 'Manrope'; src: url('/assets/fonts/manrope-latin.woff2') format('woff2'); font-style: normal; font-weight: 400 800; font-display: swap; }
  html { scroll-padding-top: 76px; }
  body > .skip-link { display: none; }
  .version2 { --v2-ink: #061a1c; --v2-ink-2: #0d2a2d; --v2-cream: #f5f4e9; --v2-paper: #fffef8; --v2-lime: #bad305; --v2-mint: #dfe8dc; --v2-muted: #53686a; --font-display: 'Manrope', system-ui, sans-serif; --font-body: 'Manrope', system-ui, sans-serif; background: var(--v2-cream); color: var(--v2-ink); font-family: var(--font-body); overflow: clip; }
  .version2 [hidden] { display: none !important; }
  .version2 *, .version2 *::before, .version2 *::after { box-sizing: border-box; }
  .version2 h1, .version2 h2, .version2 h3 { font-family: var(--font-display); letter-spacing: -0.035em; }
  .version2 h2 { font-size: clamp(2.1rem, 3.2vw, 3.25rem); line-height: 1; font-weight: 750; }
  .version2 p { font-family: var(--font-body); }
  .v2-container { width: min(1240px, calc(100% - 48px)); margin-inline: auto; }
  .v2-section { padding: clamp(46px, 4.8vw, 68px) 0; }
  .v2-kicker { margin: 0 0 16px; color: var(--v2-lime); font: 750 .72rem/1 var(--font-body); letter-spacing: .15em; text-transform: uppercase; }
  .v2-kicker--dark { color: #668000; }
  .v2-button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; padding: 13px 22px; border-radius: 999px; font: 700 .94rem/1 var(--font-body); transition: transform 180ms ease, background 180ms ease, color 180ms ease; }
  .v2-button:hover { transform: translateY(-2px); }
  .v2-button--lime { background: var(--v2-lime); color: var(--v2-ink); }
  .v2-button--dark { background: var(--v2-ink); color: white; }
  .v2-heading { margin-bottom: 30px; }
  .v2-heading h2 span { color: #779400; }
  .v2-heading--light h2, .v2-heading--light h3 { color: white; }
  .v2-heading--light h2 span { color: var(--v2-lime); }
  .v2-heading--center { max-width: 960px; margin-inline: auto; text-align: center; }
  .v2-heading--stories { max-width: 790px; }
  .v2-heading--center > p:last-child { max-width: 650px; margin: 20px auto 0; color: rgba(255,255,255,.62); font-size: .96rem; }
  .v2-heading--split { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(280px, .75fr); gap: 50px; align-items: end; }
  .v2-heading__aside { margin: 0; color: var(--v2-muted); font-size: .96rem; line-height: 1.65; }
  .v2-heading--light .v2-heading__aside { color: rgba(255,255,255,.68); }

  .v2-nav { position: fixed; inset: 0 0 auto; z-index: 80; height: 72px; background: rgba(6,26,28,.88); backdrop-filter: saturate(150%) blur(18px); border-bottom: 1px solid rgba(255,255,255,.08); }
  .v2-nav__inner { height: 100%; display: flex; align-items: center; gap: 34px; }
  .v2-nav__brand { width: 190px; flex: 0 0 auto; }
  .v2-nav__brand img { width: 100%; border-radius: 0; }
  .v2-nav__links { display: flex; margin-left: auto; gap: 28px; }
  .v2-nav__links a { color: rgba(255,255,255,.76); font: 500 .86rem/1 var(--font-body); }
  .v2-nav__links a:hover { color: var(--v2-lime); }
  .v2-nav__cta.is-muted { background: transparent; box-shadow: inset 0 0 0 1px rgba(255,255,255,.28); color: rgba(255,255,255,.76); }
  .v2-nav__cta.is-muted:hover { background: rgba(255,255,255,.08); color: white; }

  .v2-hero { position: relative; min-height: 100svh; display: flex; align-items: center; padding: 104px 0 32px; background-image: linear-gradient(90deg, rgba(6,26,28,.96) 0%, rgba(6,26,28,.82) 34%, rgba(6,26,28,.18) 53%, rgba(6,26,28,.76) 76%, rgba(6,26,28,.94) 100%), url('/assets/img/v2/tempora-galeria6.webp'); background-position: center; background-size: cover; color: white; }
  .v2-hero__glow { display: none; }
  .v2-hero__grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(390px, 440px); gap: 90px; align-items: center; }
  .v2-hero__copy { max-width: 510px; min-width: 0; padding: 26px 0; }
  .v2-hero h1 { max-width: 520px; margin: 0; color: white; font-size: clamp(3.3rem, 4.8vw, 5rem); font-weight: 780; line-height: .91; }
  .v2-hero h1 span { display: block; color: var(--v2-lime); }
  .v2-hero__checks { display: grid; gap: 9px; margin-top: 24px; }
  .v2-hero__checks li { display: flex; align-items: flex-start; color: rgba(255,255,255,.88); font: 600 .84rem/1.42 var(--font-body); }
  .v2-hero__checks span { color: var(--v2-lime); margin-right: 5px; }
  .v2-hero__mobile-visual { display: none; }
  .v2-hero__actions { display: flex; align-items: center; gap: 24px; margin-top: 22px; }
  .v2-text-link { color: white; font: 600 .94rem/1 var(--font-body); }
  .v2-text-link span { color: var(--v2-lime); margin-left: 4px; }
  .v2-form-shell { position: sticky; top: 86px; justify-self: end; width: 100%; max-width: 440px; padding: 0; border: 1px solid rgba(255,255,255,.34); border-radius: 22px; background: var(--v2-paper); box-shadow: 0 28px 70px rgba(0,0,0,.34); overflow: hidden; }
  .v2-form-shell__topline { display: flex; justify-content: space-between; padding: 15px 20px 12px; border-top: 5px solid var(--v2-lime); color: var(--v2-ink); font: 750 .68rem/1 var(--font-body); letter-spacing: .08em; text-transform: uppercase; }
  .version2 .v2-form-shell .lead-card__body { padding: 14px 20px 16px !important; border-radius: 0; background: var(--v2-paper) !important; }
  .version2 .v2-form-shell .lead-card__intro { margin: 0 0 14px !important; color: var(--v2-ink) !important; font-size: .96rem !important; line-height: 1.35 !important; text-align: left !important; text-shadow: none !important; }
  .version2 .v2-form-shell .lead-card__intro br { display: none; }
  .version2 .v2-form-shell .lead-card__footer { padding: 11px 20px 13px !important; border-radius: 0 !important; background: #edf0e8 !important; }
  .version2 .v2-form-shell .lead-card__footer p { color: var(--v2-muted) !important; font-size: .7rem !important; font-weight: 550 !important; }
  .version2 .v2-form-shell .lead-form__progress-track { height: 10px !important; border-radius: 999px; background: #e1e4da !important; }
  .version2 .v2-form-shell .lead-form__progress-meter { border-radius: 999px; font-size: .72rem !important; }
  .version2 .v2-form-shell .lead-form__step.is-active { grid-template-columns: 1fr; gap: 8px; }
  .version2 .v2-form-shell .lead-form__field-group { display: flex; flex-direction: column; justify-content: flex-end; }
  .version2 .v2-form-shell .lead-form__label { min-height: 30px; margin-bottom: 4px; color: var(--v2-ink) !important; font-size: .72rem !important; font-weight: 650 !important; line-height: 1.25 !important; }
  .version2 .v2-form-shell .lead-form__label[for='telefono'] { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .version2 .v2-form-shell .lead-form__label--sr { min-height: 0; }
  .version2 .v2-form-shell .lead-form__field,
  .version2 .v2-form-shell .lead-form__select select { height: 46px !important; padding-inline: 12px !important; border: 1px solid #d8ddd2 !important; border-radius: 9px !important; background: #f7f8f3 !important; font-size: .8rem !important; }
  .version2 .v2-form-shell .btn-form { min-height: 45px; border-radius: 10px !important; background: var(--v2-ink) !important; color: white !important; font-weight: 750 !important; }
  .version2 .v2-form-shell .btn-form--prev { background: #d9ddd4 !important; }

  .v2-results { background: var(--v2-ink); }
  .v2-results__grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 14px; }
  .v2-case { padding: 10px; border: 1px solid rgba(255,255,255,.1); border-radius: 20px; background: rgba(255,255,255,.055); }
  .v2-case--wide { grid-column: auto; }
  .v2-case__compare { position: relative; aspect-ratio: 1.34 / 1; overflow: hidden; border-radius: 14px; background: #d7d7d7; --split: 50%; }
  .v2-case__compare img { width: 100%; height: 100%; border-radius: 0; object-fit: cover; transition: transform 500ms ease; }
  .v2-case:hover .v2-case__compare img { transform: scale(1.025); }
  .v2-case__after { position: absolute; inset: 0; }
