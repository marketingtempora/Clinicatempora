<script>
  const formShell = document.querySelector<HTMLElement>('[data-form-shell]');
  const floating = document.querySelector<HTMLElement>('[data-floating]');
  const navCta = document.querySelector<HTMLElement>('.v2-nav__cta');
  let pulseTimer: number | undefined;

  const emphasizeForm = () => {
    if (!formShell) return;
    window.clearTimeout(pulseTimer);
    formShell.classList.remove('is-emphasized');
    void formShell.offsetWidth;
    formShell.classList.add('is-emphasized');
    pulseTimer = window.setTimeout(() => formShell.classList.remove('is-emphasized'), 900);
  };

  if (formShell && floating && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        const floatingIsVisible = !entry.isIntersecting;
        floating.classList.toggle('is-visible', floatingIsVisible);
        navCta?.classList.toggle('is-muted', floatingIsVisible);
      },
      { threshold: 0.08 }
    );
    observer.observe(formShell);
  }

  document.querySelectorAll<HTMLAnchorElement>('.version2 a[href="#form"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!formShell) return;
      const rect = formShell.getBoundingClientRect();
      const visible = rect.top < innerHeight && rect.bottom > 64;
      if (visible) {
        event.preventDefault();
        emphasizeForm();
      }
    });
  });

  document.querySelectorAll<HTMLInputElement>('[data-comparison-range]').forEach((range) => {
    const comparison = range.closest<HTMLElement>('[data-comparison]');
    range.addEventListener('input', () => comparison?.style.setProperty('--split', `${range.value}%`));
  });

  const mediaTrack = document.querySelector<HTMLElement>('[data-media-track]');
  const mediaSlides = [...document.querySelectorAll<HTMLElement>('[data-media-slide]')];
  const mediaDots = [...document.querySelectorAll<HTMLButtonElement>('[data-media-dot]')];
  let activeMedia = 0;

  const showMedia = (index: number) => {
    if (!mediaTrack || mediaSlides.length === 0) return;
    activeMedia = (index + mediaSlides.length) % mediaSlides.length;
    mediaTrack.style.transform = `translateX(-${activeMedia * 100}%)`;
    mediaSlides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === activeMedia));
    mediaDots.forEach((dot, dotIndex) => {
      const active = dotIndex === activeMedia;
      dot.classList.toggle('is-active', active);
      dot.setAttribute('aria-current', active ? 'true' : 'false');
    });
  };

  document.querySelector<HTMLButtonElement>('[data-media-prev]')?.addEventListener('click', () => showMedia(activeMedia - 1));
  document.querySelector<HTMLButtonElement>('[data-media-next]')?.addEventListener('click', () => showMedia(activeMedia + 1));
  mediaDots.forEach((dot) => dot.addEventListener('click', () => showMedia(Number(dot.dataset.mediaDot || 0))));
</script>
