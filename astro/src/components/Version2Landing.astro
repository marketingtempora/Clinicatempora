<script>
  const formShell = document.querySelector<HTMLElement>('[data-form-shell]');
  const floating = document.querySelector<HTMLElement>('[data-floating]');
  let pulseTimer: number | undefined;

  const emphasizeForm = () => {
    if (!formShell) return;
    window.clearTimeout(pulseTimer);
    formShell.classList.remove('is-emphasized');
    void formShell.offsetWidth;
    formShell.classList.add('is-emphasized');
    pulseTimer = window.setTimeout(() => formShell.classList.remove('is-emphasized'), 900);
  };

  if (formShell && floating && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => floating.classList.toggle('is-visible', !entry.isIntersecting),
      { threshold: 0.08 }
    );
    observer.observe(formShell);
  }

  document.querySelectorAll<HTMLAnchorElement>('.version2 a[href="#form"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!formShell) return;
      const rect = formShell.getBoundingClientRect();
      const visible = rect.top < innerHeight && rect.bottom > 64;
      if (visible) {
        event.preventDefault();
        emphasizeForm();
      }
    });
  });

  const techTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tech-tab]')];
  const techPanels = [...document.querySelectorAll<HTMLElement>('[data-tech-panel]')];

  const activateTechnique = (name: string) => {
    techTabs.forEach((tab) => {
      const active = tab.dataset.techTab === name;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
    });
    techPanels.forEach((panel) => { panel.hidden = panel.dataset.techPanel !== name; });
  };

  techTabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateTechnique(tab.dataset.techTab || 'fue'));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const nextIndex = event.key === 'ArrowRight'
        ? (index + 1) % techTabs.length
        : (index - 1 + techTabs.length) % techTabs.length;
      const nextTab = techTabs[nextIndex];
      activateTechnique(nextTab.dataset.techTab || 'fue');
      nextTab.focus();
    });
  });
</script>
