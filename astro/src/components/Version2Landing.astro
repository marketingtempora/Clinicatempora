---
import LeadForm from './LeadForm.astro';
import YouTubeFacade from './YouTubeFacade.astro';

const results = [
  { before: '001A-1.jpg', after: '001B-1.jpg', label: 'Caso 01 · línea frontal' },
  { before: '002A.jpg', after: '002B.jpg', label: 'Caso 02 · densidad superior' },
  { before: '006A.jpg', after: '006B.jpg', label: 'Caso 03 · entradas' },
] as const;

const faqs = [
  {
    question: '¿Cómo sé si soy candidato a un implante capilar?',
    answer:
      'La evaluación revisa tu tipo de alopecia, la calidad de la zona donante, tus antecedentes y el resultado que buscas. Con esa información el equipo puede indicarte si el implante es adecuado para ti.',
  },
  {
    question: '¿Cómo sé si necesito FUE o FUSS?',
    answer:
      'No tienes que decidirlo antes. El equipo evalúa tu tipo de alopecia, zona donante, cantidad de folículos y objetivos para recomendar FUE, FUSS o una combinación de ambas.',
  },
  {
    question: '¿Es necesario internarse?',
    answer:
      'No. Es una cirugía ambulatoria con anestesia local. Recibes indicaciones de cuidado y continúas con el programa de seguimiento de la clínica.',
  },
  {
    question: '¿Cuándo se ven los resultados?',
    answer:
      'El crecimiento es progresivo. Cada evolución es distinta y el resultado se controla durante los meses posteriores a la cirugía.',
  },
  {
    question: '¿Puedo evaluarme si vivo fuera de Santiago?',
    answer:
      'Sí. El formulario permite elegir evaluación presencial o a distancia. La sucursal de Santiago está en Providencia, a pasos del metro Los Leones.',
  },
  {
    question: '¿El procedimiento duele?',
    answer:
      'La cirugía se realiza con anestesia local. Durante la evaluación el equipo explica cada etapa, las sensaciones esperables y los cuidados para una recuperación confortable.',
  },
] as const;
---

<div class="version2">
  <header class="v2-nav" data-v2-nav>
    <div class="v2-container v2-nav__inner">
      <a class="v2-nav__brand" href="#inicio" aria-label="Clínica Témpora, inicio">
        <img src="/assets/img/logo-tempora-blanco.webp" width="321" height="54" alt="Clínica Témpora" />
      </a>
      <nav class="v2-nav__links" aria-label="Navegación principal">
        <a href="#resultados">Resultados</a>
        <a href="#proceso">Proceso</a>
        <a href="#tecnicas">Técnicas</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <a class="v2-button v2-button--lime v2-nav__cta" href="#form">Quiero agendar</a>
    </div>
  </header>

  <main id="hero">
    <section class="v2-hero" id="inicio">
      <div class="v2-hero__glow" aria-hidden="true"></div>
      <div class="v2-container v2-hero__grid">
        <div class="v2-hero__copy">
          <p class="v2-kicker">Clínica especializada · Providencia</p>
          <h1>Implante capilar que se planifica para <span>verse natural.</span></h1>
          <p class="v2-hero__lead">
            Técnicas FUE y FUSS elegidas según tu diagnóstico, con cirugía ambulatoria y seguimiento médico antes y después del procedimiento.
          </p>
          <ul class="v2-hero__checks" aria-label="Características principales">
            <li><span aria-hidden="true">✓</span> Evaluación presencial o a distancia</li>
            <li><span aria-hidden="true">✓</span> Seguimiento antes y después</li>
            <li><span aria-hidden="true">✓</span> Pabellones autorizados en Providencia</li>
          </ul>
          <div class="v2-hero__actions">
            <a class="v2-button v2-button--lime" href="#form">Quiero agendar</a>
            <a class="v2-text-link" href="#proceso">Cómo funciona <span aria-hidden="true">↘</span></a>
          </div>

        </div>

        <div class="v2-form-shell" id="form" data-form-shell>
          <div class="v2-form-shell__topline">
            <span>Evaluación capilar</span>
            <span>2 min aprox.</span>
          </div>
          <LeadForm fieldsPerStep={4} />
        </div>
      </div>
    </section>

    <section class="v2-proofbar" aria-label="Datos de la clínica">
      <div class="v2-container v2-proofbar__grid">
        <div><strong>15+ años</strong><span>de experiencia en restauración capilar</span></div>
        <div><strong>2</strong><span>pabellones de cirugía mayor</span></div>
        <div><strong>FUE + FUSS</strong><span>la técnica la define tu diagnóstico</span></div>
        <div><strong>Los Leones</strong><span>Suecia 0142, oficina 603</span></div>
      </div>
    </section>

    <section class="v2-results v2-section" id="resultados">
      <div class="v2-container">
        <div class="v2-heading v2-heading--center v2-heading--light">
          <p class="v2-kicker">Resultados reales de Clínica Témpora</p>
          <h2>Una línea capilar no se copia.<br /><span>Se diseña para cada persona.</span></h2>
          <p>Casos publicados por la clínica. El resultado y la evolución pueden variar entre pacientes.</p>
        </div>

        <div class="v2-results__grid">
          {results.map((result, index) => (
            <article class:list={['v2-case', { 'v2-case--wide': index === 0 }]}>
              <div class="v2-case__images">
                <figure>
                  <img src={`/assets/img/v2/${result.before}`} width="1080" height="872" alt={`${result.label}, antes del implante capilar`} loading="lazy" />
                  <figcaption>Antes</figcaption>
                </figure>
                <figure>
                  <img src={`/assets/img/v2/${result.after}`} width="1080" height="872" alt={`${result.label}, después del implante capilar`} loading="lazy" />
                  <figcaption>Después</figcaption>
                </figure>
              </div>
              <h3>{result.label}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="v2-method v2-section" id="proceso">
      <div class="v2-container v2-method__grid">
        <div class="v2-method__copy">
          <p class="v2-kicker v2-kicker--dark">Un plan médico, no una solución genérica</p>
          <h2>No se trata de “poner pelo”. Se trata de decidir bien dónde, cuánto y cómo.</h2>
          <p class="v2-method__lead">
            El diseño, la zona donante y la técnica determinan la naturalidad del resultado. Por eso el proceso comienza con un diagnóstico y termina con seguimiento.
          </p>

          <ol class="v2-steps">
            <li><span>01</span><div><strong>Evaluación</strong><p>Revisamos alopecia, zona donante, objetivos y antecedentes.</p></div></li>
            <li><span>02</span><div><strong>Diseño</strong><p>Definimos la línea capilar y la cantidad estimada de folículos.</p></div></li>
            <li><span>03</span><div><strong>Cirugía</strong><p>Aplicamos FUE, FUSS o ambas según la indicación médica.</p></div></li>
            <li><span>04</span><div><strong>Seguimiento</strong><p>Acompañamos la evolución con controles postoperatorios.</p></div></li>
          </ol>
        </div>

        <div class="v2-method__gallery" aria-label="Proceso clínico en Clínica Témpora">
          <img class="v2-method__gallery-main" src="/assets/img/v2/hero-foto.webp" width="984" height="711" alt="Procedimiento de implante capilar en Clínica Témpora" loading="lazy" />
          <img src="/assets/img/v2/tempora-galeria3.webp" width="868" height="859" alt="Evaluación médica personalizada en Clínica Témpora" loading="lazy" />
          <img src="/assets/img/v2/tempora-galeria6.webp" width="920" height="797" alt="Preparación de paciente para cirugía capilar" loading="lazy" />
        </div>
      </div>
      <div class="v2-container v2-tech-switcher" id="tecnicas">
        <div class="v2-tech-switcher__intro">
          <p class="v2-kicker v2-kicker--dark">La técnica se decide en evaluación</p>
          <h3>FUE o FUSS: compara sin salir del proceso.</h3>
          <p>No tienes que llegar sabiendo cuál elegir. Revisa sus diferencias y el equipo indicará cuál responde mejor a tu caso.</p>
          <div class="v2-tech-switcher__tabs" role="tablist" aria-label="Comparar técnicas de implante capilar">
            <button type="button" role="tab" aria-selected="true" aria-controls="panel-fue" id="tab-fue" data-tech-tab="fue">Técnica FUE</button>
            <button type="button" role="tab" aria-selected="false" aria-controls="panel-fuss" id="tab-fuss" data-tech-tab="fuss">Técnica FUSS</button>
          </div>
        </div>
        <div class="v2-tech-switcher__panels">
          <article id="panel-fue" role="tabpanel" aria-labelledby="tab-fue" data-tech-panel="fue">
            <span>Extracción folículo a folículo</span>
            <h3>FUE</h3>
            <p>Procedimiento mínimamente invasivo, sin cicatriz lineal y con una recuperación más rápida y confortable.</p>
            <ul><li>Permite llevar el cabello muy corto</li><li>Extracción individual</li><li>Depende de la capacidad de la zona donante</li></ul>
          </article>
          <article id="panel-fuss" role="tabpanel" aria-labelledby="tab-fuss" data-tech-panel="fuss" hidden>
            <span>Mayor volumen de injertos</span>
            <h3>FUSS</h3>
            <p>Alternativa eficaz para alopecias extensas o zonas donantes más pequeñas, con cierre tricofítico avanzado.</p>
            <ul><li>Permite obtener gran volumen de cabello</li><li>Separación bajo microscopio</li><li>Optimiza la zona donante en casos indicados</li></ul>
          </article>
        </div>
      </div>
    </section>

    <section class="v2-media v2-section" id="historias">
      <div class="v2-container">
        <div class="v2-heading v2-heading--split v2-heading--light">
          <div>
            <p class="v2-kicker">Casos, no promesas</p>
            <h2>La experiencia contada por quienes la vivieron.</h2>
          </div>
          <p class="v2-heading__aside">Pacientes y medios han documentado el proceso, la evolución y el acompañamiento de Clínica Témpora.</p>
        </div>

        <div class="v2-media__feature">
          <div class="v2-media__video">
            <YouTubeFacade
              id="3YyPCaqcIXQ"
              alt="Reportaje de 24 Horas sobre el implante capilar de Jorge Coke Hevia"
              thumb="/assets/img/v2/youtube-3YyPCaqcIXQ.jpg"
            />
          </div>
          <div class="v2-media__copy">
            <span>Reportaje 24 Horas</span>
            <h3>Un caso real seguido durante un año.</h3>
            <p>Evaluación, cirugía, evolución progresiva y una conversación transparente sobre lo que puede conseguirse en un caso de alopecia avanzada.</p>
          </div>
        </div>

        <div class="v2-media__secondary">
          <article>
            <YouTubeFacade
              id="Oth49NiG8Y0"
              alt="Testimonio de paciente sobre su experiencia en Clínica Témpora"
              thumb="/assets/img/v2/youtube-Oth49NiG8Y0.jpg"
            />
            <h3>“Mi experiencia con el implante capilar”</h3>
            <p>Testimonio de paciente · Clínica Témpora</p>
          </article>
          <article>
            <YouTubeFacade
              id="ybZsii5iUIE"
              alt="Video explicativo del proceso de implante capilar FUE"
              thumb="/assets/img/v2/youtube-ybZsii5iUIE.jpg"
            />
            <h3>Así se realiza un implante FUE</h3>
            <p>Explicación médica · Clínica Témpora</p>
          </article>
        </div>
      </div>
    </section>

    <section class="v2-clinic v2-section" id="clinica">
      <div class="v2-container v2-clinic__grid">
        <div class="v2-clinic__visual">
          <img src="/assets/img/v2/JESUS-1_00000000-2.jpg" width="600" height="600" alt="Dra. Jesús Díaz, fundadora y directora médica de Clínica Témpora" loading="lazy" />
          <img src="/assets/img/v2/FRANCISCO-1_00000000.jpg" width="600" height="600" alt="Dr. Francisco Castellón, director de restauración capilar" loading="lazy" />
        </div>
        <div class="v2-clinic__copy">
          <p class="v2-kicker v2-kicker--dark">Equipo médico especializado</p>
          <h2>Tu resultado comienza con quién evalúa y opera.</h2>
          <p>
            Clínica Témpora reúne profesionales dedicados a restauración capilar FUE y FUSS, con formación internacional y actualización continua.
          </p>
          <div class="v2-clinic__doctors">
            <div><strong>Dra. Jesús Díaz</strong><span>Fundadora y directora médica</span></div>
            <div><strong>Dr. Francisco Castellón</strong><span>Director de restauración capilar</span></div>
          </div>
          <div class="v2-clinic__location">
            <span aria-hidden="true">⌖</span>
            <div><strong>Providencia, Santiago</strong><p>Suecia 0142, oficina 603 · A pasos del metro Los Leones</p></div>
          </div>
        </div>
      </div>
    </section>

    <section class="v2-faq v2-section" id="preguntas">
      <div class="v2-container v2-faq__grid">
        <div class="v2-faq__intro">
          <p class="v2-kicker v2-kicker--dark">Antes de decidir</p>
          <h2>Preguntas que merecen respuestas claras.</h2>
          <p>Si tu duda no está aquí, déjala en tu evaluación. El objetivo no es apurarte: es ayudarte a decidir con información.</p>
          <a class="v2-button v2-button--dark" href="#form">Quiero agendar</a>
        </div>
        <div class="v2-faq__list">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.question}<span aria-hidden="true">+</span></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="v2-final">
      <div class="v2-container v2-final__panel">
        <div>
          <p class="v2-kicker">Tu caso empieza con una evaluación</p>
          <h2>Descubre qué resultado es posible para ti.</h2>
        </div>
        <a class="v2-button v2-button--lime" href="#form">Quiero agendar</a>
      </div>
    </section>
  </main>

  <footer class="v2-footer">
    <div class="v2-container v2-footer__inner">
      <img src="/assets/img/logo-tempora-blanco.webp" width="321" height="54" alt="Clínica Témpora" />
      <div><strong>Suecia 0142, oficina 603</strong><span>Providencia, Santiago</span></div>
      <div><strong>Lunes a viernes</strong><span>9:00 a 18:00 hrs.</span></div>
    </div>
  </footer>

  <a class="v2-floating" href="#form" data-floating>Quiero agendar <span aria-hidden="true">→</span></a>
</div>

<style is:global>
  @font-face { font-family: 'Manrope'; src: url('/assets/fonts/manrope-latin.woff2') format('woff2'); font-style: normal; font-weight: 400 800; font-display: swap; }
  html { scroll-padding-top: 76px; }
  body > .skip-link { display: none; }
  .version2 { --v2-ink: #061a1c; --v2-ink-2: #0d2a2d; --v2-cream: #f5f4e9; --v2-paper: #fffef8; --v2-lime: #bad305; --v2-mint: #dfe8dc; --v2-muted: #53686a; --font-display: 'Manrope', system-ui, sans-serif; --font-body: 'Manrope', system-ui, sans-serif; background: var(--v2-cream); color: var(--v2-ink); font-family: var(--font-body); overflow: clip; }
  .version2 [hidden] { display: none !important; }
  .version2 *, .version2 *::before, .version2 *::after { box-sizing: border-box; }
  .version2 h1, .version2 h2, .version2 h3 { font-family: var(--font-display); letter-spacing: -0.035em; }
  .version2 h2 { font-size: clamp(2.25rem, 3.7vw, 3.8rem); line-height: 1; font-weight: 750; }
  .version2 p { font-family: var(--font-body); }
  .v2-container { width: min(1240px, calc(100% - 48px)); margin-inline: auto; }
  .v2-section { padding: clamp(62px, 6.5vw, 94px) 0; }
  .v2-kicker { margin: 0 0 16px; color: var(--v2-lime); font: 750 .72rem/1 var(--font-body); letter-spacing: .15em; text-transform: uppercase; }
  .v2-kicker--dark { color: #668000; }
  .v2-button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; padding: 13px 22px; border-radius: 999px; font: 700 .94rem/1 var(--font-body); transition: transform 180ms ease, background 180ms ease, color 180ms ease; }
  .v2-button:hover { transform: translateY(-2px); }
  .v2-button--lime { background: var(--v2-lime); color: var(--v2-ink); }
  .v2-button--dark { background: var(--v2-ink); color: white; }
  .v2-heading { margin-bottom: 42px; }
  .v2-heading h2 span { color: #779400; }
  .v2-heading--light h2, .v2-heading--light h3 { color: white; }
  .v2-heading--light h2 span { color: var(--v2-lime); }
  .v2-heading--center { max-width: 960px; margin-inline: auto; text-align: center; }
  .v2-heading--center > p:last-child { max-width: 650px; margin: 20px auto 0; color: rgba(255,255,255,.62); font-size: .96rem; }
  .v2-heading--split { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(280px, .75fr); gap: 50px; align-items: end; }
  .v2-heading__aside { margin: 0; color: var(--v2-muted); font-size: .96rem; line-height: 1.65; }
  .v2-heading--light .v2-heading__aside { color: rgba(255,255,255,.68); }

  .v2-nav { position: fixed; inset: 0 0 auto; z-index: 80; height: 72px; background: rgba(6,26,28,.88); backdrop-filter: saturate(150%) blur(18px); border-bottom: 1px solid rgba(255,255,255,.08); }
  .v2-nav__inner { height: 100%; display: flex; align-items: center; gap: 34px; }
  .v2-nav__brand { width: 190px; flex: 0 0 auto; }
  .v2-nav__brand img { width: 100%; border-radius: 0; }
  .v2-nav__links { display: flex; margin-left: auto; gap: 28px; }
  .v2-nav__links a { color: rgba(255,255,255,.76); font: 500 .86rem/1 var(--font-body); }
  .v2-nav__links a:hover { color: var(--v2-lime); }

  .v2-hero { position: relative; min-height: 0; padding: 116px 0 56px; background: var(--v2-ink); color: white; }
  .v2-hero__glow { position: absolute; width: 720px; height: 720px; left: -260px; top: -260px; border-radius: 50%; background: radial-gradient(circle, rgba(186,211,5,.18), transparent 68%); pointer-events: none; }
  .v2-hero__grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(360px, .76fr); gap: 48px; align-items: center; }
  .v2-hero__copy { min-width: 0; }
  .v2-hero h1 { max-width: 720px; margin: 0; color: white; font-size: clamp(3.4rem, 5.1vw, 5.2rem); font-weight: 750; line-height: .94; }
  .v2-hero h1 span { display: block; color: var(--v2-lime); }
  .v2-hero__lead { max-width: 680px; margin: 22px 0 20px; color: rgba(255,255,255,.74); font-size: clamp(1rem, 1.25vw, 1.12rem); line-height: 1.55; }
  .v2-hero__checks { display: flex; flex-wrap: wrap; gap: 10px; }
  .v2-hero__checks li { padding: 8px 12px; border: 1px solid rgba(255,255,255,.14); border-radius: 999px; color: rgba(255,255,255,.82); font: 550 .78rem/1.2 var(--font-body); }
  .v2-hero__checks span { color: var(--v2-lime); margin-right: 5px; }
  .v2-hero__actions { display: flex; align-items: center; gap: 24px; margin-top: 22px; }
  .v2-text-link { color: white; font: 600 .94rem/1 var(--font-body); }
  .v2-text-link span { color: var(--v2-lime); margin-left: 4px; }
  .v2-form-shell { position: sticky; top: 90px; justify-self: end; width: 100%; max-width: 420px; padding: 10px; border: 1px solid rgba(255,255,255,.15); border-radius: 24px; background: rgba(255,255,255,.07); box-shadow: 0 22px 60px rgba(0,0,0,.3); }
  .v2-form-shell__topline { display: flex; justify-content: space-between; padding: 5px 8px 15px; color: rgba(255,255,255,.66); font: 600 .72rem/1 var(--font-body); letter-spacing: .08em; text-transform: uppercase; }
  .version2 .v2-form-shell .lead-card__body { padding: 22px !important; border-radius: 16px 16px 0 0; background: var(--v2-paper) !important; }
  .version2 .v2-form-shell .lead-card__intro { margin: 0 0 20px !important; color: var(--v2-ink) !important; font-size: 1rem !important; line-height: 1.4 !important; text-shadow: none !important; }
  .version2 .v2-form-shell .lead-card__intro br:first-child { display: none; }
  .version2 .v2-form-shell .lead-card__footer { padding: 13px 20px !important; border-radius: 0 0 16px 16px !important; background: var(--v2-ink-2) !important; }
  .version2 .v2-form-shell .lead-card__footer p { color: rgba(255,255,255,.72) !important; font-size: .78rem !important; font-weight: 500 !important; }
  .version2 .v2-form-shell .lead-form__progress-track { height: 10px !important; border-radius: 999px; background: #e1e4da !important; }
  .version2 .v2-form-shell .lead-form__progress-meter { border-radius: 999px; font-size: .72rem !important; }
  .version2 .v2-form-shell .lead-form__step.is-active { gap: 8px; }
  .version2 .v2-form-shell .lead-form__label { margin-bottom: 5px; color: var(--v2-ink) !important; font-size: .88rem !important; font-weight: 600 !important; }
  .version2 .v2-form-shell .lead-form__field,
  .version2 .v2-form-shell .lead-form__select select { height: 48px !important; border: 1px solid #dce0d6 !important; border-radius: 10px !important; background: white !important; }
  .version2 .v2-form-shell .btn-form { min-height: 48px; border-radius: 999px !important; background: var(--v2-lime) !important; color: var(--v2-ink) !important; font-weight: 700 !important; }
  .version2 .v2-form-shell .btn-form--prev { background: #d9ddd4 !important; }

  .v2-proofbar { background: var(--v2-lime); }
  .v2-proofbar__grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .v2-proofbar__grid > div { min-height: 92px; display: grid; align-content: center; padding: 18px 26px; border-left: 1px solid rgba(6,26,28,.17); }
  .v2-proofbar__grid > div:last-child { border-right: 1px solid rgba(6,26,28,.17); }
  .v2-proofbar strong { display: block; margin-bottom: 6px; color: var(--v2-ink); font: 800 1.35rem/1 var(--font-display); letter-spacing: -.025em; }
  .v2-proofbar span { color: rgba(6,26,28,.72); font: 600 .78rem/1.35 var(--font-body); }

  .v2-results { background: var(--v2-ink); }
  .v2-results__grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 14px; }
  .v2-case { padding: 10px; border: 1px solid rgba(255,255,255,.1); border-radius: 20px; background: rgba(255,255,255,.055); }
  .v2-case--wide { grid-column: auto; }
  .v2-case__images { display: grid; grid-template-columns: repeat(2,1fr); gap: 8px; }
