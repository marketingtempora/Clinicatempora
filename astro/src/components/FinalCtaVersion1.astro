---
import { cta, installments } from '../data/content';
---

<section class="final-v1">
  <div class="container">
    <div class="final-v1__panel reveal" data-reveal="fade">
      <div class="final-v1__visual">
        <img src="/assets/img/v2/SEBASTIAN.jpg" width="750" height="750" alt="Paciente de Clínica Témpora compartiendo su experiencia" loading="lazy" />
        <span>Una evaluación permite proyectar un resultado acorde a tu caso.</span>
      </div>
      <div class="final-v1__main">
        <p class="final-v1__eyebrow">TU PRÓXIMO PASO</p>
        <h2>{cta.title}</h2>
        <p>Agenda una evaluación con nuestros especialistas.</p>
        <a
          href="https://ff.healthatom.io/xVvfZu"
          data-cta-event="tempora_v1_final_autoagenda_click"
          data-cta-action="autoagenda"
          data-cta-location="final"
          data-form-version="v1"
        >Autoagendar mi evaluación <span aria-hidden="true">↗</span></a>

        <div class="final-v1__finance">
          <strong>12 CUOTAS</strong>
          <p>{installments.title}</p>
          <small>{installments.note}</small>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-v1 {
    padding: 18px 0 52px;
    background: var(--cream);
  }

  .final-v1__panel {
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
    gap: 12px;
    padding: 14px;
    border-radius: 36px;
    background: var(--ink);
    box-shadow: 0 28px 65px rgba(6, 26, 28, 0.16);
  }

  .final-v1__visual {
    position: relative;
    min-height: 320px;
    overflow: hidden;
    border-radius: 24px;
  }

  .final-v1__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(6, 26, 28, 0.88));
  }

  .final-v1__visual img {
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
  }

  .final-v1__visual span {
    position: absolute;
    z-index: 1;
    right: 24px;
    bottom: 24px;
    left: 24px;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .final-v1__main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 320px;
    padding: 32px;
    border-radius: 24px;
    background:
      radial-gradient(circle at 86% 12%, rgba(186, 211, 5, 0.2), transparent 27%),
      var(--teal);
  }

  .final-v1__eyebrow {
    margin: 0 0 18px;
    color: var(--lime);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .final-v1 h2 {
    max-width: 650px;
    color: var(--cream);
    font-size: clamp(3rem, 4.7vw, 4.8rem);
    letter-spacing: -0.055em;
    line-height: 0.94;
  }

  .final-v1__main > p:not(.final-v1__eyebrow) {
    margin: 22px 0 30px;
    color: rgba(248, 246, 230, 0.72);
  }

  .final-v1__main > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100%, 260px);
    padding: 14px 15px 14px 20px;
    border-radius: 999px;
    background: var(--lime);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .final-v1__main > a span {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
  }

  .final-v1__finance {
    display: grid;
    grid-template-columns: auto minmax(240px, 1fr) minmax(230px, 0.65fr);
    align-items: center;
    gap: 20px;
    width: 100%;
    margin-top: 36px;
    padding-top: 22px;
    border-top: 1px solid rgba(248, 246, 230, 0.14);
  }

  .final-v1__finance strong {
    padding: 8px 12px;
    border: 1px solid rgba(186, 211, 5, 0.38);
    border-radius: 999px;
    color: var(--lime);
    font-family: var(--font-display);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  .final-v1__finance p,
  .final-v1__finance small {
    margin: 0;
  }

  .final-v1__finance p {
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .final-v1__finance small {
    color: rgba(248, 246, 230, 0.5);
    font-size: 0.65rem;
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .final-v1__panel { grid-template-columns: minmax(230px, 0.68fr) minmax(0, 1.32fr); }
    .final-v1__visual { min-height: 310px; }
    .final-v1__main { min-height: 310px; }
    .final-v1__finance { grid-template-columns: auto 1fr; }
    .final-v1__finance small { grid-column: 2; }
  }

  @media (max-width: 620px) {
    .final-v1 { padding: 14px 0 44px; }
    .final-v1__panel { grid-template-columns: 1fr; padding: 9px; border-radius: 28px; }
    .final-v1__visual { min-height: 170px; max-height: 200px; border-radius: 20px; }
    .final-v1__visual span { right: 18px; bottom: 18px; left: 18px; }
    .final-v1__main { min-height: 0; padding: 24px 20px; border-radius: 20px; }
    .final-v1__eyebrow { margin-bottom: 12px; }
    .final-v1 h2 { font-size: 2.25rem; line-height: .98; }
    .final-v1__main > p:not(.final-v1__eyebrow) { margin: 14px 0 18px; }
    .final-v1__main > a { width: 100%; }
    .final-v1__finance { grid-template-columns: auto 1fr; gap: 8px 12px; margin-top: 20px; padding-top: 16px; }
    .final-v1__finance strong { justify-self: start; }
    .final-v1__finance small { grid-column: 1 / -1; }
  }
</style>
