---
import { whyUs } from '../data/content';
---

<section class="clinic-v1" id="elegirnos">
  <div class="container">
    <div class="clinic-v1__head reveal" data-reveal="fade">
      <div>
        <p class="clinic-v1__eyebrow">EXPERIENCIA CLÍNICA</p>
        <h2>{whyUs.title}</h2>
      </div>
      <p>
        Somos especialistas en implante capilar, con profesionales reconocidos internacionalmente.
        Además, somos los <strong>primeros en Chile</strong> en tener el Dermatoscopio Leviacam,
        tecnología que nos permite realizar un diagnóstico absolutamente objetivo y certero.
      </p>
    </div>

    <div class="clinic-v1__story">
      <div class="clinic-v1__gallery reveal" data-reveal="fade-right">
        {whyUs.gallery.map((photo, index) => (
          <figure class:list={['clinic-v1__photo', `clinic-v1__photo--${index + 1}`]}>
            <img
              src={`/assets/img/${photo.base}-768.webp`}
              srcset={`/assets/img/${photo.base}-400.webp 400w, /assets/img/${photo.base}-768.webp 768w`}
              sizes={index === 0 ? '(max-width: 767px) calc(100vw - 40px), 720px' : '(max-width: 767px) 48vw, 360px'}
              alt={photo.alt}
              loading="lazy"
              width="768"
              height="513"
            />
          </figure>
        ))}
      </div>

      <aside class="clinic-v1__proof reveal" data-reveal="fade">
        <p class="clinic-v1__proof-label">RESPALDO</p>
        <div class="clinic-v1__stats">
          {whyUs.stats.map((stat, index) => (
            <article class="clinic-v1__stat">
              <span class="clinic-v1__stat-index">0{index + 1}</span>
              <p>{stat.kicker}</p>
              <strong>
                <span class="counter" data-to={stat.to} data-duration="2000">0</span>{stat.suffix}
              </strong>
              <small>{stat.title}</small>
            </article>
          ))}
        </div>
        <a href="#form">QUIERO AGENDAR <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </div>
</section>

<style>
  .clinic-v1 {
    padding: 104px 0;
    background:
      linear-gradient(135deg, rgba(186, 211, 5, 0.09), transparent 34%),
      #eef0df;
    overflow: hidden;
  }

  .clinic-v1__head {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.72fr);
    align-items: end;
    gap: 60px;
    margin-bottom: 46px;
  }

  .clinic-v1__eyebrow,
  .clinic-v1__proof-label {
    margin: 0 0 16px;
    color: var(--teal);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.2em;
  }

  .clinic-v1 h2 {
    max-width: 720px;
    color: var(--teal);
    font-size: clamp(3rem, 5vw, 5.1rem);
    letter-spacing: -0.055em;
    line-height: 0.96;
  }

  .clinic-v1__head > p {
    margin: 0 0 5px;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.72;
  }

  .clinic-v1__head strong { color: var(--ink); }

  .clinic-v1__story {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.62fr);
    gap: 18px;
  }

  .clinic-v1__gallery {
    display: grid;
    grid-template-columns: 1.45fr 0.75fr;
    grid-template-rows: repeat(2, 1fr);
    gap: 12px;
    min-height: 550px;
  }

  .clinic-v1__photo {
    min-width: 0;
    margin: 0;
    overflow: hidden;
  }

  .clinic-v1__photo--1 {
    grid-row: 1 / 3;
    border-radius: 30px 12px 12px 30px;
  }

  .clinic-v1__photo--2 { border-radius: 12px 30px 12px 12px; }
  .clinic-v1__photo--3 { border-radius: 12px 12px 30px 12px; }

  .clinic-v1__photo img {
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .clinic-v1__photo:hover img { transform: scale(1.035); }

  .clinic-v1__proof {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 32px;
    border-radius: 30px;
    background: var(--ink);
    color: var(--cream);
  }

  .clinic-v1__proof-label { color: var(--lime); }

  .clinic-v1__stats {
    display: grid;
    gap: 14px;
    margin-block: auto;
  }

  .clinic-v1__stat {
    position: relative;
    padding: 22px 0;
    border-top: 1px solid rgba(248, 246, 230, 0.16);
  }

  .clinic-v1__stat-index {
    position: absolute;
    top: 24px;
    right: 0;
    color: rgba(248, 246, 230, 0.34);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .clinic-v1__stat p,
  .clinic-v1__stat small {
    display: block;
    margin: 0;
    color: rgba(248, 246, 230, 0.65);
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .clinic-v1__stat strong {
    display: block;
    margin: 4px 0;
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 2.5rem;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .clinic-v1__proof > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 24px;
    padding-top: 22px;
    border-top: 1px solid rgba(248, 246, 230, 0.16);
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 800;
  }

  .clinic-v1__proof > a span {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .clinic-v1__head { grid-template-columns: 1fr; gap: 22px; }
    .clinic-v1__story { grid-template-columns: 1fr; }
    .clinic-v1__proof { min-height: 330px; }
    .clinic-v1__stats { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }

  @media (max-width: 620px) {
    .clinic-v1 { padding: 72px 0; }
    .clinic-v1__head { margin-bottom: 30px; }
    .clinic-v1 h2 { font-size: 3rem; }
    .clinic-v1__gallery {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: 310px 150px;
      gap: 8px;
      min-height: 0;
    }
    .clinic-v1__photo--1 {
      grid-column: 1 / -1;
      grid-row: 1;
      border-radius: 24px 24px 10px 10px;
    }
    .clinic-v1__photo--2 { border-radius: 10px 10px 10px 24px; }
    .clinic-v1__photo--3 { border-radius: 10px 10px 24px 10px; }
    .clinic-v1__proof { min-height: 0; padding: 26px 22px; border-radius: 24px; }
    .clinic-v1__stats { gap: 12px; }
    .clinic-v1__stat strong { font-size: 2rem; }
  }
</style>
