---
import Layout from '../../layouts/Layout.astro';

// Ruta privada solicitada: /CMS/.
const supabaseUrl = (import.meta.env.PUBLIC_SUPABASE_URL ?? '').replace(/\/+$/, '');
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

<Layout
  title="Centro de formularios | Clínica Témpora"
  description="Panel privado de formularios e integraciones de Clínica Témpora."
  robots="noindex, nofollow"
>
  <main
    class="cms"
    id="hero"
    data-cms
    data-supabase-url={supabaseUrl}
    data-supabase-key={supabaseKey}
  >
    <section class="login" data-login-view>
      <div class="login__brand">
        <img src="/assets/img/logo-tempora-blanco.webp" alt="Clínica Témpora" width="321" height="54" />
        <p>Centro privado de formularios</p>
      </div>

      <form class="login__card" data-login-form>
        <p class="eyebrow">Acceso interno</p>
        <h1>Formularios y Pipedrive</h1>
        <p class="login__copy">Revisa cada solicitud recibida y el estado de su sincronización.</p>

        <label for="cms-email">Correo</label>
        <input id="cms-email" name="email" type="email" autocomplete="username" required />

        <label for="cms-password">Contraseña</label>
        <input id="cms-password" name="password" type="password" autocomplete="current-password" required />

        <p class="form-status" data-login-status role="status" aria-live="polite"></p>
        <button type="submit">Ingresar</button>
      </form>

      <div class="setup" data-setup hidden>
        <strong>Falta conectar el almacenamiento.</strong>
        <span>Configura PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_ANON_KEY para habilitar el acceso.</span>
      </div>
    </section>

    <section class="dashboard" data-dashboard hidden>
      <header class="topbar">
        <div class="topbar__brand">
          <img src="/assets/img/logo-tempora-blanco.webp" alt="Clínica Témpora" width="321" height="54" />
          <span>CMS</span>
        </div>
        <div class="topbar__actions">
          <span data-user-email></span>
          <button class="button button--quiet" type="button" data-refresh>Actualizar</button>
          <button class="button button--outline" type="button" data-logout>Salir</button>
        </div>
      </header>

      <div class="workspace">
        <div class="page-head">
          <div>
            <p class="eyebrow">Respaldo comercial</p>
            <h1>Centro de formularios</h1>
            <p>Todos los registros recibidos, incluso si Make o Pipedrive presentan un error.</p>
          </div>
          <button class="button button--primary" type="button" data-export>Exportar CSV</button>
        </div>

        <section class="metrics" aria-label="Resumen de formularios">
          <article><span>Total recibidos</span><strong data-metric="total">0</strong></article>
          <article><span>En Pipedrive</span><strong data-metric="success">0</strong></article>
          <article><span>Pendientes</span><strong data-metric="pending">0</strong></article>
          <article class="metric--danger"><span>Con error</span><strong data-metric="failed">0</strong></article>
        </section>

        <section class="records">
          <div class="filters">
            <label class="search">
              <span class="sr-only">Buscar formularios</span>
              <input type="search" placeholder="Buscar nombre, correo o teléfono" data-search />
            </label>
            <label>
              <span>Estado</span>
              <select data-status-filter>
                <option value="all">Todos</option>
                <option value="success">Sincronizados</option>
                <option value="pending">Pendientes</option>
                <option value="failed">Con error</option>
              </select>
            </label>
            <label>
              <span>Formulario</span>
              <select data-version-filter>
                <option value="all">V1 y V2</option>
                <option value="v1">Versión 1</option>
                <option value="v2">Versión 2</option>
              </select>
            </label>
            <p class="records__count"><strong data-visible-count>0</strong> registros</p>
          </div>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Paciente</th>
                  <th>Contacto</th>
                  <th>Formulario</th>
                  <th>Campaña</th>
                  <th>Estado</th>
                  <th>Intentos</th>
                  <th><span class="sr-only">Acciones</span></th>
                </tr>
              </thead>
              <tbody data-table-body></tbody>
            </table>
            <div class="empty" data-empty hidden>
              <strong>No hay formularios para mostrar.</strong>
              <span>Cambia los filtros o actualiza los datos.</span>
            </div>
          </div>
          <p class="records__status" data-records-status role="status" aria-live="polite"></p>
        </section>
      </div>
    </section>

    <dialog class="details" data-details>
      <div class="details__head">
        <div>
          <p class="eyebrow">Detalle del formulario</p>
          <h2 data-detail-name></h2>
        </div>
        <button type="button" class="details__close" data-close-details aria-label="Cerrar">×</button>
      </div>
      <div class="details__status" data-detail-status></div>
      <dl data-detail-list></dl>
      <div class="details__error" data-detail-error hidden></div>
      <div class="details__actions">
        <button class="button button--quiet" type="button" data-requeue>Reintentar sincronización</button>
        <button class="button button--primary" type="button" data-close-details>Listo</button>
      </div>
    </dialog>
  </main>
</Layout>

<style>
  :global(body) { background: #eef1ed; }
  :global(.skip-link) { display: none; }
  .cms { min-height: 100svh; color: var(--ink); }
  .cms [hidden] { display: none !important; }
  .eyebrow { margin: 0 0 6px; color: #718500; font-size: .72rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  button, input, select { font: inherit; }
  button { cursor: pointer; }

  .login { display: grid; min-height: 100svh; grid-template-columns: minmax(300px, .8fr) minmax(420px, 1.2fr); background: var(--ink); }
  .login__brand { display: flex; min-height: 100%; padding: 48px; flex-direction: column; justify-content: space-between; background: #0b292c; color: var(--cream); }
  .login__brand img { width: 220px; border-radius: 0; }
  .login__brand p { margin: 0; color: rgba(248,246,230,.68); font-size: 1.1rem; }
  .login__card { align-self: center; width: min(460px, calc(100% - 48px)); margin: 40px auto; padding: 42px; border-top: 4px solid var(--lime); border-radius: 22px; background: var(--cream); box-shadow: 0 30px 90px rgba(0,0,0,.28); }
  .login__card h1 { margin-bottom: 12px; font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -.04em; line-height: 1; }
  .login__copy { margin-bottom: 28px; color: var(--muted); }
  .login__card label { display: block; margin: 16px 0 6px; font-size: .84rem; font-weight: 700; }
  .login__card input { width: 100%; height: 50px; padding: 0 14px; border: 1px solid #ccd3cc; border-radius: 10px; background: #fff; color: var(--ink); }
  .login__card button { width: 100%; margin-top: 22px; padding: 14px; border: 0; border-radius: 11px; background: var(--lime); color: var(--ink); font-weight: 800; }
  .form-status { min-height: 22px; margin: 12px 0 -8px; color: #9e2828; font-size: .84rem; }
  .setup { position: fixed; right: 24px; bottom: 24px; display: flex; max-width: 520px; padding: 14px 18px; gap: 4px; flex-direction: column; border-left: 4px solid #cc3d3d; border-radius: 10px; background: #fff; box-shadow: 0 16px 45px rgba(0,0,0,.22); }

  .dashboard { min-height: 100svh; }
  .topbar { position: sticky; z-index: 10; top: 0; display: flex; min-height: 68px; padding: 10px clamp(20px, 4vw, 54px); align-items: center; justify-content: space-between; background: var(--ink); color: var(--cream); box-shadow: 0 5px 24px rgba(6,26,28,.18); }
  .topbar__brand { display: flex; align-items: center; gap: 18px; }
  .topbar__brand img { width: 170px; border-radius: 0; }
  .topbar__brand span { padding: 3px 9px; border: 1px solid rgba(248,246,230,.26); border-radius: 20px; font-size: .68rem; font-weight: 800; letter-spacing: .12em; }
  .topbar__actions { display: flex; align-items: center; gap: 10px; }
  .topbar__actions > span { margin-right: 8px; color: rgba(248,246,230,.65); font-size: .78rem; }
  .workspace { width: min(1480px, 100%); margin: 0 auto; padding: 42px clamp(18px, 4vw, 54px) 70px; }
  .page-head { display: flex; margin-bottom: 28px; align-items: end; justify-content: space-between; gap: 24px; }
  .page-head h1 { font-size: clamp(2.2rem, 4vw, 3.8rem); letter-spacing: -.045em; line-height: 1; }
  .page-head p:last-child { margin: 12px 0 0; color: var(--muted); }
  .button { padding: 10px 15px; border-radius: 9px; font-size: .82rem; font-weight: 750; }
  .button--primary { border: 1px solid var(--lime); background: var(--lime); color: var(--ink); }
  .button--quiet { border: 1px solid #cbd2ca; background: #fff; color: var(--ink); }
  .button--outline { border: 1px solid rgba(248,246,230,.28); background: transparent; color: var(--cream); }
  .metrics { display: grid; margin-bottom: 22px; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 12px; }
  .metrics article { padding: 19px 20px; border: 1px solid #dce1dc; border-radius: 14px; background: #fff; }
  .metrics span { display: block; margin-bottom: 7px; color: #617073; font-size: .76rem; font-weight: 700; }
  .metrics strong { font-family: var(--font-display); font-size: 2rem; line-height: 1; }
  .metrics .metric--danger strong { color: #a52e2e; }
  .records { border: 1px solid #dce1dc; border-radius: 16px; background: #fff; overflow: hidden; }
  .filters { display: flex; padding: 14px; align-items: end; gap: 10px; border-bottom: 1px solid #e3e7e3; }
  .filters label { display: grid; gap: 4px; color: #637174; font-size: .68rem; font-weight: 750; }
  .filters input, .filters select { height: 39px; padding: 0 11px; border: 1px solid #d2d8d2; border-radius: 8px; background: #f8faf7; color: var(--ink); font-size: .8rem; }
  .filters .search { flex: 1; }
  .records__count { margin: 0 4px 8px auto; color: #697578; font-size: .75rem; white-space: nowrap; }
  .table-wrap { position: relative; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .78rem; }
  th { padding: 11px 12px; background: #f5f7f4; color: #657174; font-size: .66rem; letter-spacing: .05em; text-align: left; text-transform: uppercase; white-space: nowrap; }
  td { padding: 13px 12px; border-top: 1px solid #edf0ed; vertical-align: middle; }
  tbody tr:hover { background: #fbfcf8; }
  .patient strong, .contact span { display: block; }
  .patient span, .contact span { color: #6d797a; font-size: .7rem; }
  .status-pill { display: inline-flex; padding: 4px 8px; align-items: center; gap: 5px; border-radius: 20px; background: #eef0eb; color: #566265; font-size: .67rem; font-weight: 800; white-space: nowrap; }
  .status-pill::before { width: 6px; height: 6px; border-radius: 50%; background: currentColor; content: ''; }
  .status-pill--success { background: #e9f3df; color: #426d22; }
  .status-pill--failed { background: #f8e5e3; color: #9b302b; }
  .status-pill--pending { background: #f6f0d7; color: #806b13; }
  .row-action { padding: 6px 9px; border: 1px solid #d7ddd7; border-radius: 7px; background: #fff; color: var(--ink); font-size: .7rem; font-weight: 750; }
  .empty { display: flex; min-height: 220px; align-items: center; justify-content: center; flex-direction: column; color: #6d797a; }
  .empty strong { color: var(--ink); }
  .records__status { min-height: 24px; margin: 0; padding: 0 14px 10px; color: #9b302b; font-size: .76rem; }

  .details { width: min(680px, calc(100% - 28px)); max-height: calc(100svh - 40px); padding: 0; border: 0; border-radius: 18px; color: var(--ink); box-shadow: 0 28px 100px rgba(0,0,0,.35); }
  .details::backdrop { background: rgba(6,26,28,.72); backdrop-filter: blur(5px); }
  .details__head { display: flex; padding: 25px 26px 18px; align-items: start; justify-content: space-between; border-bottom: 1px solid #e3e7e3; }
  .details__head h2 { font-size: 1.7rem; }
  .details__close { width: 34px; height: 34px; border: 0; border-radius: 50%; background: #eef1ed; font-size: 1.4rem; line-height: 1; }
  .details__status { padding: 15px 26px 0; }
  .details dl { display: grid; margin: 0; padding: 20px 26px; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14px 22px; overflow-y: auto; }
  .details dt { color: #718083; font-size: .66rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
  .details dd { margin: 2px 0 0; overflow-wrap: anywhere; font-size: .82rem; }
  .details__error { margin: 0 26px 18px; padding: 12px; border-left: 3px solid #a52e2e; background: #f9e9e7; color: #7d2824; font-size: .78rem; }
  .details__actions { display: flex; padding: 17px 26px 22px; justify-content: flex-end; gap: 9px; border-top: 1px solid #e3e7e3; }

  @media (max-width: 820px) {
    .login { grid-template-columns: 1fr; }
    .login__brand { min-height: 140px; padding: 28px; }
    .login__brand p { display: none; }
    .topbar__actions > span { display: none; }
    .metrics { grid-template-columns: repeat(2,1fr); }
    .page-head { align-items: start; flex-direction: column; }
    .filters { align-items: stretch; flex-wrap: wrap; }
    .filters .search { flex: 1 0 100%; }
    .records__count { margin-left: 0; }
  }
  @media (max-width: 520px) {
    .login__card { padding: 30px 24px; }
    .topbar__brand img { width: 135px; }
    .topbar__actions { gap: 6px; }
    .topbar .button { padding: 8px 10px; }
    .workspace { padding-top: 28px; }
    .metrics { gap: 8px; }
    .metrics article { padding: 16px; }
    .details dl { grid-template-columns: 1fr; }
    .details__actions { align-items: stretch; flex-direction: column-reverse; }
  }
</style>

<script>
  type Lead = Record<string, string | number | null>;
  type Session = { access_token: string; refresh_token?: string; expires_at?: number; user?: { email?: string } };

  const root = document.querySelector<HTMLElement>('[data-cms]');
  const SESSION_KEY = 'tempora_cms_session';

  if (root) {
    const supabaseUrl = root.dataset.supabaseUrl ?? '';
    const supabaseKey = root.dataset.supabaseKey ?? '';
    const configured = Boolean(supabaseUrl && supabaseKey);
    const loginView = root.querySelector<HTMLElement>('[data-login-view]')!;
    const loginForm = root.querySelector<HTMLFormElement>('[data-login-form]')!;
    const loginStatus = root.querySelector<HTMLElement>('[data-login-status]')!;
    const setup = root.querySelector<HTMLElement>('[data-setup]')!;
    const dashboard = root.querySelector<HTMLElement>('[data-dashboard]')!;
    const tableBody = root.querySelector<HTMLTableSectionElement>('[data-table-body]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const recordsStatus = root.querySelector<HTMLElement>('[data-records-status]')!;
    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const statusFilter = root.querySelector<HTMLSelectElement>('[data-status-filter]')!;
    const versionFilter = root.querySelector<HTMLSelectElement>('[data-version-filter]')!;
    const details = root.querySelector<HTMLDialogElement>('[data-details]')!;
    let session: Session | null = null;
    let leads: Lead[] = [];
    let eventsBySubmission = new Map<string, Lead>();
    let visibleLeads: Lead[] = [];
    let selectedLead: Lead | null = null;

    setup.hidden = configured;
    if (!configured) loginForm.querySelector<HTMLButtonElement>('button[type="submit"]')!.disabled = true;

    const escapeCsv = (value: unknown) => {
      let text = String(value ?? '').replaceAll('"', '""');
      if (/^[=+\-@]/.test(text)) text = `'${text}`;
      return `"${text}"`;
    };

    const getSession = () => {
      try { return JSON.parse(sessionStorage.getItem(SESSION_KEY) ?? 'null') as Session | null; }
      catch { return null; }
    };

    const saveSession = (value: Session | null) => {
      session = value;
      if (value) sessionStorage.setItem(SESSION_KEY, JSON.stringify(value));
      else sessionStorage.removeItem(SESSION_KEY);
    };

    const api = async (path: string, init: RequestInit = {}, token = session?.access_token) => {
      const response = await fetch(`${supabaseUrl}${path}`, {
        ...init,
        headers: {
          apikey: supabaseKey,
          ...(token ? { Authorization: `Bearer ${token}` } : {}),
          ...(init.body ? { 'Content-Type': 'application/json' } : {}),
          ...init.headers,
        },
      });
      if (!response.ok) {
        const body = await response.json().catch(() => ({}));
        throw new Error(body.message ?? body.error_description ?? body.hint ?? `HTTP ${response.status}`);
      }
      return response.status === 204 ? null : response.json().catch(() => null);
    };

    const formatDate = (value: unknown) => value
      ? new Intl.DateTimeFormat('es-CL', { dateStyle: 'short', timeStyle: 'short' }).format(new Date(String(value)))
      : '—';

    const effectiveStatus = (lead: Lead) => {
      const status = String(lead.pipedrive_status ?? 'pending');
      if (status === 'success') return 'success';
      if (status === 'failed') return 'failed';
      const event = eventsBySubmission.get(String(lead.submission_id ?? ''));
      if (event?.event_type === 'make_failed') return 'failed';
      return 'pending';
    };

    const statusLabel = (status: string) => ({ success: 'Sincronizado', failed: 'Con error', pending: 'Pendiente' })[status] ?? 'Pendiente';

    const setMetric = (name: string, value: number) => {
      const element = root.querySelector<HTMLElement>(`[data-metric="${name}"]`);
      if (element) element.textContent = String(value);
    };

    const createCell = (row: HTMLTableRowElement, value: string, className = '') => {
      const cell = row.insertCell();
      cell.textContent = value;
      if (className) cell.className = className;
      return cell;
    };

    const renderMetrics = () => {
      const statuses = leads.map(effectiveStatus);
      setMetric('total', leads.length);
      setMetric('success', statuses.filter((value) => value === 'success').length);
      setMetric('pending', statuses.filter((value) => value === 'pending').length);
      setMetric('failed', statuses.filter((value) => value === 'failed').length);
    };

    const renderTable = () => {
      const needle = search.value.trim().toLocaleLowerCase('es');
      visibleLeads = leads.filter((lead) => {
        const haystack = [lead.nombre, lead.apellido, lead.email, lead.telefono, lead.utm_campaign]
          .join(' ').toLocaleLowerCase('es');
        return (!needle || haystack.includes(needle))
          && (statusFilter.value === 'all' || effectiveStatus(lead) === statusFilter.value)
          && (versionFilter.value === 'all' || lead.form_version === versionFilter.value);
      });

      tableBody.replaceChildren();
      visibleLeads.forEach((lead) => {
        const row = tableBody.insertRow();
        createCell(row, formatDate(lead.created_at));

        const patient = createCell(row, '', 'patient');
        const patientName = document.createElement('strong');
        patientName.textContent = `${lead.nombre ?? ''} ${lead.apellido ?? ''}`.trim() || 'Sin nombre';
        const source = document.createElement('span');
        source.textContent = String(lead.source_form ?? 'Providencia');
        patient.append(patientName, source);

        const contact = createCell(row, '', 'contact');
        const email = document.createElement('span');
        email.textContent = String(lead.email ?? '—');
        const phone = document.createElement('span');
        phone.textContent = String(lead.telefono ?? '—');
        contact.append(email, phone);

        createCell(row, String(lead.form_version ?? '—').toUpperCase());
        createCell(row, String(lead.utm_campaign ?? lead.utm_source ?? 'Sin UTM'));

        const status = effectiveStatus(lead);
        const statusCell = row.insertCell();
        const badge = document.createElement('span');
        badge.className = `status-pill status-pill--${status}`;
        badge.textContent = statusLabel(status);
        statusCell.append(badge);

        createCell(row, String(lead.attempt_count ?? 0));
        const actionCell = row.insertCell();
        const action = document.createElement('button');
        action.type = 'button';
        action.className = 'row-action';
        action.textContent = 'Ver detalle';
        action.addEventListener('click', () => openDetails(lead));
        actionCell.append(action);
      });

      root.querySelector<HTMLElement>('[data-visible-count]')!.textContent = String(visibleLeads.length);
      empty.hidden = visibleLeads.length > 0;
    };

    const detailFields: Array<[string, string]> = [
      ['Fecha', 'created_at'], ['Correo', 'email'], ['Teléfono', 'telefono'],
      ['Cirugía', 'urgencia_cirugia'], ['Evaluación', 'medio_evaluacion'], ['Género', 'genero'],
      ['Horario', 'horario_contacto'], ['Formulario', 'form_version'], ['Origen', 'source_form'],
      ['UTM source', 'utm_source'], ['UTM medium', 'utm_medium'], ['UTM campaign', 'utm_campaign'],
      ['UTM content', 'utm_content'], ['UTM term', 'utm_term'], ['Campaign ID', 'campaign_id'],
      ['Submission ID', 'submission_id'], ['Persona Pipedrive', 'pipedrive_person_id'],
      ['Negocio Pipedrive', 'pipedrive_deal_id'], ['Último intento', 'last_attempt_at'],
    ];

    function openDetails(lead: Lead) {
      selectedLead = lead;
      root.querySelector<HTMLElement>('[data-detail-name]')!.textContent = `${lead.nombre ?? ''} ${lead.apellido ?? ''}`.trim();
      const status = effectiveStatus(lead);
      const statusBox = root.querySelector<HTMLElement>('[data-detail-status]')!;
      statusBox.replaceChildren();
      const badge = document.createElement('span');
      badge.className = `status-pill status-pill--${status}`;
      badge.textContent = statusLabel(status);
      statusBox.append(badge);

      const list = root.querySelector<HTMLElement>('[data-detail-list]')!;
      list.replaceChildren();
      detailFields.forEach(([label, field]) => {
        const wrapper = document.createElement('div');
        const term = document.createElement('dt');
        const description = document.createElement('dd');
        term.textContent = label;
        const raw = lead[field];
        description.textContent = field.endsWith('_at') ? formatDate(raw) : String(raw ?? '—');
        wrapper.append(term, description);
        list.append(wrapper);
      });

      const error = root.querySelector<HTMLElement>('[data-detail-error]')!;
      const event = eventsBySubmission.get(String(lead.submission_id ?? ''));
      const message = lead.integration_error ?? event?.error_message;
      error.hidden = !message;
      error.textContent = message ? `Error: ${message}` : '';
      details.showModal();
    }

    const loadRecords = async () => {
      recordsStatus.textContent = 'Actualizando…';
      try {
        const [leadRows, eventRows] = await Promise.all([
          api('/rest/v1/leads?select=*&order=created_at.desc&limit=500'),
          api('/rest/v1/lead_delivery_events?select=*&order=created_at.desc&limit=1000'),
        ]);
        leads = Array.isArray(leadRows) ? leadRows : [];
        eventsBySubmission = new Map();
        if (Array.isArray(eventRows)) {
          eventRows.forEach((event: Lead) => {
            const id = String(event.submission_id ?? '');
            if (id && !eventsBySubmission.has(id)) eventsBySubmission.set(id, event);
          });
        }
        renderMetrics();
        renderTable();
        recordsStatus.textContent = '';
      } catch (error) {
        recordsStatus.textContent = error instanceof Error ? error.message : 'No fue posible cargar los formularios.';
        if (/JWT|token|401/i.test(recordsStatus.textContent)) logout();
      }
    };

    const showDashboard = async () => {
      loginView.hidden = true;
      dashboard.hidden = false;
      root.querySelector<HTMLElement>('[data-user-email]')!.textContent = session?.user?.email ?? '';
      await loadRecords();
    };

    const logout = () => {
      saveSession(null);
      dashboard.hidden = true;
      loginView.hidden = false;
      loginForm.reset();
    };

    loginForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!configured) return;
      loginStatus.textContent = 'Ingresando…';
      const body = new FormData(loginForm);
      try {
        const value = await api('/auth/v1/token?grant_type=password', {
          method: 'POST',
          body: JSON.stringify({ email: body.get('email'), password: body.get('password') }),
        }, '');
        saveSession(value as Session);
        loginStatus.textContent = '';
        await showDashboard();
      } catch (error) {
        loginStatus.textContent = error instanceof Error ? error.message : 'No fue posible iniciar sesión.';
      }
    });

    root.querySelector('[data-logout]')?.addEventListener('click', logout);
    root.querySelector('[data-refresh]')?.addEventListener('click', loadRecords);
    search.addEventListener('input', renderTable);
    statusFilter.addEventListener('change', renderTable);
    versionFilter.addEventListener('change', renderTable);
    root.querySelectorAll('[data-close-details]').forEach((button) => button.addEventListener('click', () => details.close()));

    root.querySelector('[data-requeue]')?.addEventListener('click', async () => {
      if (!selectedLead?.submission_id) return;
      const button = root.querySelector<HTMLButtonElement>('[data-requeue]')!;
      button.disabled = true;
      try {
        await api(`/rest/v1/leads?submission_id=eq.${encodeURIComponent(String(selectedLead.submission_id))}`, {
          method: 'PATCH',
          headers: { Prefer: 'return=minimal' },
          body: JSON.stringify({
            delivery_status: 'received',
            make_status: 'pending',
            pipedrive_status: 'pending',
            integration_error: null,
            requeue_requested_at: new Date().toISOString(),
          }),
        });
        details.close();
        await loadRecords();
      } catch (error) {
        const errorBox = root.querySelector<HTMLElement>('[data-detail-error]')!;
        errorBox.hidden = false;
        errorBox.textContent = error instanceof Error ? error.message : 'No fue posible reencolar el registro.';
      } finally {
        button.disabled = false;
      }
    });

    root.querySelector('[data-export]')?.addEventListener('click', () => {
      const fields = ['created_at', 'nombre', 'apellido', 'email', 'telefono', 'form_version', 'source_form', 'utm_source', 'utm_medium', 'utm_campaign', 'pipedrive_status', 'integration_error', 'submission_id'];
      const rows = [fields.join(','), ...visibleLeads.map((lead) => fields.map((field) => escapeCsv(lead[field])).join(','))];
      const blob = new Blob([`\uFEFF${rows.join('\n')}`], { type: 'text/csv;charset=utf-8' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `formularios-tempora-${new Date().toISOString().slice(0, 10)}.csv`;
      link.click();
      URL.revokeObjectURL(link.href);
    });

    session = getSession();
    if (configured && session?.access_token) void showDashboard();
  }
</script>
