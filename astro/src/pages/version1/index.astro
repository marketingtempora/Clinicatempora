---
import Layout from '../../layouts/Layout.astro';
import HeaderVersion1 from '../../components/HeaderVersion1.astro';
import HeroVersion1 from '../../components/HeroVersion1.astro';
import ClaimVersion1 from '../../components/ClaimVersion1.astro';
import ResultsVersion1 from '../../components/ResultsVersion1.astro';
import ClinicVersion1 from '../../components/ClinicVersion1.astro';
import ProcessVersion1 from '../../components/ProcessVersion1.astro';
import TestimonialsVersion1 from '../../components/TestimonialsVersion1.astro';
import FinalCtaVersion1 from '../../components/FinalCtaVersion1.astro';
import FooterVersion1 from '../../components/FooterVersion1.astro';
---

<Layout>
  <div class="version1">
    <HeaderVersion1 />
    <main>
      <HeroVersion1 />
      <ClaimVersion1 />
      <ResultsVersion1 />
      <ClinicVersion1 />
      <ProcessVersion1 />
      <TestimonialsVersion1 />
      <FinalCtaVersion1 />
    </main>
    <FooterVersion1 />

    <a class="version1__mobile-cta" href="#form">QUIERO AGENDAR</a>
  </div>
</Layout>

<style is:global>
  body > .skip-link {
    display: none;
  }

  .version1 [hidden] {
    display: none !important;
  }

  .version1__mobile-cta {
    display: none;
  }

  @media (max-width: 767px) {
    .version1 {
      padding-bottom: 70px;
    }

    .version1__mobile-cta {
      position: fixed;
      right: 12px;
      bottom: 10px;
      left: 12px;
      z-index: 50;
      display: block;
      padding: 15px 20px;
      border: 1px solid rgba(248, 246, 230, 0.22);
      border-radius: 999px;
      background: var(--ink);
      box-shadow: 0 12px 30px rgba(6, 26, 28, 0.28);
      color: var(--cream);
      font-family: var(--font-display);
      font-size: 0.98rem;
      font-weight: 800;
      line-height: 1.2;
      text-align: center;
      opacity: 0;
      pointer-events: none;
      transform: translateY(18px);
      transition: opacity 220ms ease, transform 220ms ease;
    }

    .version1__mobile-cta.is-visible {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
  }
</style>

<script>
  const mobileCta = document.querySelector<HTMLElement>('.version1__mobile-cta');
  const leadForm = document.getElementById('form');

  if (mobileCta && leadForm && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => mobileCta.classList.toggle('is-visible', !entry.isIntersecting),
      { threshold: 0.08 }
    );
    observer.observe(leadForm);
  }
</script>
