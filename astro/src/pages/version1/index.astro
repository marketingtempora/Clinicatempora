---
import Layout from '../../layouts/Layout.astro';
import HeaderVersion1 from '../../components/HeaderVersion1.astro';
import HeroVersion1 from '../../components/HeroVersion1.astro';
import ClaimVersion1 from '../../components/ClaimVersion1.astro';
import ResultsVersion1 from '../../components/ResultsVersion1.astro';
import ClinicVersion1 from '../../components/ClinicVersion1.astro';
import ProcessVersion1 from '../../components/ProcessVersion1.astro';
import TestimonialsVersion1 from '../../components/TestimonialsVersion1.astro';
import FinalCtaVersion1 from '../../components/FinalCtaVersion1.astro';
import FooterVersion1 from '../../components/FooterVersion1.astro';
---

<Layout>
  <div class="version1">
    <HeaderVersion1 />
    <main>
      <HeroVersion1 />
      <ClaimVersion1 />
      <ResultsVersion1 />
      <ClinicVersion1 />
      <ProcessVersion1 />
      <TestimonialsVersion1 />
      <FinalCtaVersion1 />
    </main>
    <FooterVersion1 />

    <a class="version1__floating-cta" href="#form">Quiero agendar <span aria-hidden="true">→</span></a>
  </div>
</Layout>

<style is:global>
  html {
    scroll-padding-top: 92px;
  }

  body > .skip-link {
    display: none;
  }

  .version1 [hidden] {
    display: none !important;
  }

  .version1__floating-cta {
    position: fixed;
    right: 24px;
    bottom: 22px;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 15px 18px 15px 22px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    background: var(--lime);
    box-shadow: 0 18px 50px rgba(6, 26, 28, 0.3);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    translate: 0 18px;
    transition: opacity 180ms ease, translate 180ms ease;
  }

  .version1__floating-cta span {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: white;
  }

  .version1__floating-cta.is-visible {
    opacity: 1;
    pointer-events: auto;
    translate: 0;
  }

  @media (max-width: 767px) {
    html {
      scroll-padding-top: 76px;
    }

    .version1 {
      padding-bottom: 70px;
    }

    .version1__floating-cta {
      right: 12px;
      bottom: 10px;
      left: 12px;
      justify-content: space-between;
      padding: 15px 20px;
      font-size: 0.98rem;
    }
  }
</style>

<script>
  const floatingCta = document.querySelector<HTMLElement>('.version1__floating-cta');
  const leadForm = document.getElementById('form');
  const formCard = leadForm?.closest<HTMLElement>('.hero-v1__form');

  if (floatingCta && leadForm && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => floatingCta.classList.toggle('is-visible', !entry.isIntersecting),
      { threshold: 0.08 }
    );
    observer.observe(leadForm);
  }

  let emphasisTimer: number | undefined;

  const emphasizeForm = () => {
    if (!formCard) return;
    window.clearTimeout(emphasisTimer);
    formCard.classList.remove('is-emphasized');
    void formCard.offsetWidth;
    formCard.classList.add('is-emphasized');
    emphasisTimer = window.setTimeout(() => formCard.classList.remove('is-emphasized'), 950);
  };

  document.querySelectorAll<HTMLAnchorElement>('.version1 a[href="#form"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!leadForm) return;
      const rect = leadForm.getBoundingClientRect();
      const headerHeight = document.querySelector<HTMLElement>('.v1-header')?.offsetHeight ?? 0;
      const formIsVisible = rect.top < window.innerHeight && rect.bottom > headerHeight;

      if (formIsVisible) {
        event.preventDefault();
        emphasizeForm();
      }
    });
  });
</script>
