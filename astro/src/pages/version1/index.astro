---
import Layout from '../../layouts/Layout.astro';
import HeaderVersion1 from '../../components/HeaderVersion1.astro';
import HeroVersion1 from '../../components/HeroVersion1.astro';
import ClaimVersion1 from '../../components/ClaimVersion1.astro';
import ResultsVersion1 from '../../components/ResultsVersion1.astro';
import ClinicVersion1 from '../../components/ClinicVersion1.astro';
import ProcessVersion1 from '../../components/ProcessVersion1.astro';
import TestimonialsVersion1 from '../../components/TestimonialsVersion1.astro';
import FinalCtaVersion1 from '../../components/FinalCtaVersion1.astro';
import FooterVersion1 from '../../components/FooterVersion1.astro';
---

<Layout>
  <div class="version1">
    <HeaderVersion1 />
    <main>
      <HeroVersion1 />
      <ClaimVersion1 />
      <ResultsVersion1 />
      <ClinicVersion1 />
      <ProcessVersion1 />
      <TestimonialsVersion1 />
      <FinalCtaVersion1 />
    </main>
    <FooterVersion1 />

    <div class="version1__floating-actions" data-floating-actions aria-label="Opciones para agendar">
      <a
        class="version1__floating-action version1__floating-action--contact"
        href="#form"
        data-cta-event="tempora_v1_floating_contact_click"
      data-cta-action="contacto"
      data-cta-location="floating"
      data-form-version="v1"
      >Que me contacten <span aria-hidden="true">→</span></a>
      <a
        class="version1__floating-action version1__floating-action--auto"
        href="https://ff.healthatom.io/xVvfZu"
        data-cta-event="tempora_v1_floating_autoagenda_click"
        data-cta-action="autoagenda"
        data-cta-location="floating"
        data-form-version="v1"
      >Autoagendar <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</Layout>

<style is:global>
  html {
    scroll-padding-top: 92px;
  }

  body > .skip-link {
    display: none;
  }

  .version1 [hidden] {
    display: none !important;
  }

  .version1__floating-actions {
    position: fixed;
    right: 24px;
    bottom: 22px;
    z-index: 50;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(440px, calc(100% - 48px));
    gap: 8px;
    padding: 7px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 22px;
    background: rgba(6, 26, 28, 0.94);
    box-shadow: 0 18px 50px rgba(6, 26, 28, 0.3);
    backdrop-filter: blur(16px);
    opacity: 0;
    pointer-events: none;
    translate: 0 18px;
    transition: opacity 180ms ease, translate 180ms ease;
  }

  .version1__floating-action {
    display: flex;
    min-height: 46px;
    padding: 12px 16px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 16px;
    background: var(--lime);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
  }

  .version1__floating-action span {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: white;
  }

  .version1__floating-actions.is-visible {
    opacity: 1;
    pointer-events: auto;
    translate: 0;
  }

  @media (max-width: 767px) {
    html {
      scroll-padding-top: 76px;
    }

    .version1 {
      padding-bottom: 70px;
    }

    .version1__floating-actions {
      right: 12px;
      bottom: 10px;
      left: 12px;
      width: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      padding: 6px;
    }

    .version1__floating-action {
      min-width: 0;
      padding-inline: 9px;
      font-size: 0.76rem;
    }
  }
</style>

<script>
  const floatingCta = document.querySelector<HTMLElement>('[data-floating-actions]');
  const leadForm = document.getElementById('form');
  const formCard = leadForm?.closest<HTMLElement>('.hero-v1__form');

  if (floatingCta && leadForm && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        const floatingIsVisible = !entry.isIntersecting;
        floatingCta.classList.toggle('is-visible', floatingIsVisible);
      },
      { threshold: 0.08 }
    );
    observer.observe(leadForm);
  }

  let emphasisTimer: number | undefined;

  const emphasizeForm = () => {
    if (!formCard) return;
    window.clearTimeout(emphasisTimer);
    formCard.classList.remove('is-emphasized');
    void formCard.offsetWidth;
    formCard.classList.add('is-emphasized');
    emphasisTimer = window.setTimeout(() => formCard.classList.remove('is-emphasized'), 950);
  };

  document.querySelectorAll<HTMLAnchorElement>('.version1 a[href="#form"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!leadForm) return;
      const rect = leadForm.getBoundingClientRect();
      const headerHeight = document.querySelector<HTMLElement>('.v1-header')?.offsetHeight ?? 0;
      const formIsVisible = rect.top < window.innerHeight && rect.bottom > headerHeight;

      if (formIsVisible) {
        event.preventDefault();
        emphasizeForm();
      }
    });
  });
</script>
