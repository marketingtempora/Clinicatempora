# =============================================================================
# Versión Astro – variables de entorno
# Copia este archivo a .env para desarrollo local.
# En Render: Static Site -> Environment -> Add Environment Variable.
#
# El build es estático, así que estas variables se "cocinan" dentro del JS
# durante `npm run build`. Si cambias una en Render hay que hacer redeploy.
# Por eso todas son PUBLIC_*: acaban siendo visibles en el navegador.
# =============================================================================

# --- Supabase (modo normal para un Static Site) -----------------------------
# Dashboard de Supabase -> Project Settings -> API
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# anon / public key. Es pública por diseño: sólo puede INSERT en la tabla leads
# gracias a la política RLS de supabase/schema.sql.
# ⚠️ NUNCA pongas acá la service_role key.
PUBLIC_SUPABASE_ANON_KEY=

# Tabla destino (por defecto: leads)
PUBLIC_SUPABASE_TABLE=leads

# --- Backend propio (opcional) ----------------------------------------------
# Si algún día levantas la API de ../api en Render, define esto y el formulario
# postea contra ella en lugar de Supabase (así la service_role key queda en el
# servidor). Deja vacío para usar Supabase directo.
PUBLIC_API_BASE_URL=
