# =============================================================================
# API de leads – variables de entorno
# Copia este archivo a .env para desarrollo local.
# En Render se configuran en Dashboard -> Service -> Environment.
# =============================================================================

# Puerto. En Render lo inyecta la plataforma, no hace falta tocarlo.
PORT=3000

# --- Supabase (obligatorio) --------------------------------------------------
# Dashboard de Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# service_role key: NUNCA la pongas en el front ni la subas al repo
SUPABASE_SERVICE_ROLE_KEY=
# Nombre de la tabla (por defecto: leads)
SUPABASE_LEADS_TABLE=leads

# --- CORS (recomendado) -----------------------------------------------------
# Dominios que pueden llamar a la API, separados por coma.
# Si lo dejas vacío, se aceptan todos los orígenes (sólo para desarrollo).
ALLOWED_ORIGINS=https://implantecapilar.clinicatempora.cl,http://localhost:5173,http://localhost:4321

# --- Seguridad --------------------------------------------------------------
# Token para GET/PATCH /api/leads. Genera uno largo: openssl rand -hex 32
ADMIN_TOKEN=
# Salt para hashear la IP (así no guardamos IPs en claro)
IP_HASH_SALT=cambia-esto-por-algo-aleatorio
# Máximo de envíos por IP por minuto
RATE_LIMIT_PER_MINUTE=10

# --- Notificaciones (opcional) ---------------------------------------------
# Webhook al que avisar cuando entra un lead (Slack, Make, n8n, HubSpot...)
LEAD_WEBHOOK_URL=
